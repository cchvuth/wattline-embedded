BR2_riscv=y
# The compressed instructions (RVC) for the whole user space (the C906 runs them): ~25% less code than rv64imafd, so
# less to read from the card and to keep in RAM. Built with build.sh (README.md).
BR2_RISCV_ISA_RVC=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y
BR2_DL_DIR="/work/dl"
# board/f133/patches-local: patches of your own, kept out of this repository (git-ignored); Buildroot applies them
# after this tree's (e.g. patches-local/linux/*.patch)
BR2_GLOBAL_PATCH_DIR="board/nezha/patches $(BR2_EXTERNAL_F133_PATH)/board/f133/patches $(BR2_EXTERNAL_F133_PATH)/board/f133/patches-local"
BR2_TARGET_GENERIC_HOSTNAME="f133"
BR2_TARGET_GENERIC_ISSUE="F133 (SRNUBI T313D)"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_F133_PATH)/board/f133/overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_F133_PATH)/board/f133/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.22"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_F133_PATH)/board/f133/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_F133_PATH)/board/f133/sun20i-d1s-srnubi-t313d.dts"
BR2_TARGET_ROOTFS_SQUASHFS=y
# zstd in 128 KiB blocks: the one core unpacks it far faster than xz (a cold start of the dash 1.3-1.9 s where xz took
# 2.9), and larger blocks unpack more for each read; the card has room for its tenth more
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_128K=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_OPENSBI=y
BR2_TARGET_OPENSBI_CUSTOM_VERSION=y
BR2_TARGET_OPENSBI_CUSTOM_VERSION_VALUE="1.4"
BR2_TARGET_OPENSBI_PLAT="generic"
# BR2_TARGET_OPENSBI_INSTALL_JUMP_IMG is not set
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_TARBALL=y
BR2_TARGET_UBOOT_CUSTOM_TARBALL_LOCATION="$(call github,smaeul,u-boot,2e89b706f5c956a70c989cd31665f1429e9a0b48)/uboot-2e89b706f5c956a70c989cd31665f1429e9a0b48.tar.gz"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="nezha"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_F133_PATH)/board/f133/uboot.fragment"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_OPENSBI=y
# BR2_TARGET_UBOOT_FORMAT_BIN is not set
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-sunxi-with-spl.bin"
# The card (post-image.sh, board/f133/genimage.cfg): its image, U-Boot raw at 8 KiB and the first partition FAT32;
# host-dosfstools is also the source /init links fsck.fat from (build.sh). /data, its second partition, is made at
# the first start (dash-mkdata: sfdisk, partx, mkfs.ext4) and checked at every start (S01data: e2fsck)
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_AIC8800=y
BR2_PACKAGE_G2DROT=y
# this tree's programs, built from source: the MCU's daemon; from the app checkout (/native) the dash, the Android
# Auto receiver and its decoder sink
BR2_PACKAGE_MCUD=y
BR2_PACKAGE_DASHAPP=y
BR2_PACKAGE_WATTLINE_AA=y
BR2_PACKAGE_SPIKE_VDEC=y
BR2_PACKAGE_I2C_TOOLS=y
# Bluetooth userspace, as on the Dash (dash-aa's RFCOMM profiles, bt-pan, the Commander's GDBus GATT client):
# bluetoothd + D-Bus (selected) + glib (selected). All three tarballs are already in /work/dl.
# Add to configs/f133_defconfig together with linux-bt.fragment and aic8800-mk-sdio-bt.diff.
BR2_PACKAGE_BLUEZ5_UTILS=y
# no bluetoothctl (with readline and ncurses) and no btmon: nothing on the screen runs them (the dash talks to
# bluetoothd over D-Bus; the F133's dash-aa is wired only)
# BR2_PACKAGE_BLUEZ5_UTILS_CLIENT is not set
# BR2_PACKAGE_BLUEZ5_UTILS_MONITOR is not set
# The T113 Dash's OS behaviour on the F133. The build applies this file each time: after editing, the dirclean
# list in README.md (busybox, wpa_supplicant) before ./build.sh.

# /etc/image-id (the version the dash's settings show, and dash-update compares) and the OTA public key
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_F133_PATH)/board/f133/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_F133_PATH)/board/f133/post-fakeroot.sh"
# busybox ntpd + timeout (udhcpc's ntp hook)
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_F133_PATH)/board/f133/busybox.fragment"
# WPA3-Personal (SAE). The AIC8800 does SAE with the AUTHENTICATE command (iw list on the screen); wifi-connect offers
# SAE only once this wpa_supplicant has it. Selects OpenSSL (also what aa's TLS uses).
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y

# OTA (dash-update): sig-verify; selects OpenSSL, curl and the CA bundle (HTTPS with certificate checks)
BR2_PACKAGE_DASH_OTA=y

# the AIC8800 controller is LE only (no BR/EDR): no BNEP/PAN; bnep would only load and take memory
# BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_NETWORK is not set
# Android Auto's AP for the phone (dash-aa): wpa_supplicant's AP mode, not hostapd (one binary for the station and the
# AP, the least to load); without the Wi-Fi Direct this option drags in (external.mk)
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
# the kernel's regulatory.db (signed): `iw reg set` with the device's own country (dash-aa: /data/wifi/country)
BR2_PACKAGE_WIRELESS_REGDB=y
# OpenSSL without what nothing here uses (the AA receiver's TLS, curl's HTTPS, sig-verify's Ed25519 and wpa_supplicant's
# WPA2/WPA3 keep theirs; RC4, MD4 and DES stay for wpa_supplicant): old ciphers and digests, SSLv3, compression, QUIC,
# CMP, the engines, tracing and the debug build
# BR2_PACKAGE_LIBOPENSSL_ENABLE_RC2 is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_MD2 is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_MDC2 is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_BLAKE2 is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_IDEA is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_SEED is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_RMD160 is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_WHIRLPOOL is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_BLOWFISH is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_SSL is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_SSL3 is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_WEAK_SSL is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_CAST is not set
# BR2_PACKAGE_LIBOPENSSL_UNSECURE is not set
# BR2_PACKAGE_LIBOPENSSL_DYNAMIC_ENGINE is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_COMP is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_ARGON2 is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_CMP is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_LOADER_ENGINE is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_PADLOCK_ENGINE is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_QUIC is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_SIV is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_SM2_PRECOMP_TABLE is not set
# BR2_PACKAGE_LIBOPENSSL_ENABLE_SSL_TRACE is not set
# curl for the updater only (dash-update: HTTPS to GitHub): no proxy, cookies or other protocols
# BR2_PACKAGE_LIBCURL_PROXY_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_COOKIES_SUPPORT is not set
# BR2_PACKAGE_LIBCURL_EXTRA_PROTOCOLS_FEATURES is not set
