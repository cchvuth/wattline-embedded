/*
 * The NOR's "kernel" partition: the kernel, gzipped, and its device tree, a crc32 each; U-Boot's bootm checks them,
 * unpacks the kernel to its run address and boots it with that device tree. post-image.sh makes it (gzip -9, then
 * U-Boot's mkimage -f kernel.its kernel.itb) and checks that it fits the partition (0x440000).
 * gzip, not LZMA: 0.7 MB more to read, but the one core unpacks it in 0.8 s where LZMA took 2.3 (over half of the
 * 4.3 s from power-on to the kernel's start); crc32, not sha256 (0.35 s): it is there for a bad read, not an attacker.
 */
/dts-v1/;

/ {
	description = "SRNUBI T313D: Linux and its device tree";
	#address-cells = <1>;

	images {
		kernel {
			description = "Linux";
			data = /incbin/("Image.gz");
			type = "kernel";
			arch = "riscv";
			os = "linux";
			compression = "gzip";
			load = <0x40200000>;
			entry = <0x40200000>;
			hash {
				algo = "crc32";
			};
		};

		fdt {
			description = "sun20i-d1s-srnubi-t313d";
			data = /incbin/("f133.dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			hash {
				algo = "crc32";
			};
		};
	};

	configurations {
		default = "conf";

		conf {
			description = "SRNUBI T313D";
			kernel = "kernel";
			fdt = "fdt";
		};
	};
};
