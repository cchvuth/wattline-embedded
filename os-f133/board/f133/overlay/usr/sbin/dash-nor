#!/bin/sh
# dash-nor {status|copy}: the card install's system onto the screen's built-in flash (the NOR), from the dash's
# Settings (Advanced, Built-in flash). Only on a card install (booted from the card: no root=mtd: on the command line),
# whose card holds rootfs.sqfs (its root) and nor/kernel.itb, nor/u-boot-sunxi-with-spl.bin (the same build's, for
# the NOR: post-image.sh's card folder; an update replaces them with the rest).
#   status  /run/dash-nor.status for the UI (state= note=): ready, or stock (the stock firmware still on the NOR: the
#           copy saves it to the card first). No file when there is nothing to copy (not a card install, no NOR files).
#   copy    the stock firmware saved to the card first while it is on the NOR (stock.bin, the chip read twice: nor.sh
#           read; an exact copy already there is kept), then nor.sh flash (the root, the kernel, U-Boot if it changed:
#           each read back) and nor.sh seed (the card's settings, Wi-Fi networks and SSH keys into the NOR's /data).
#           States: copying (the step in note=), then done, or error (why in note=). Its log: nor.txt in the boot's log
#           folder on the card.
# The NOR is not in use on a card install (the root and /data are the card's), so it is written while the dash runs.
# The card still boots first while it is in; without it, the screen starts from the NOR.
# DASH_NOR_*: other paths (tests).
set -u
SD=${DASH_NOR_SD:-/mnt/sd}
RUN=${DASH_NOR_RUN:-/run}
CMDLINE=${DASH_NOR_CMDLINE:-/proc/cmdline}
MTD=${DASH_NOR_MTD:-/proc/mtd}
NOR=${DASH_NOR_TOOL:-/usr/sbin/nor.sh}
LOG=${DASH_NOR_LOG:-/var/log/sd/nor.txt}
[ -d "${LOG%/*}" ] || LOG=/dev/null   # no log folder: a redirect to it would fail the command it is on
ST=$RUN/dash-nor.status
status() { printf 'state=%s\nnote=%s\n' "$1" "${2:-}" > "$ST.tmp" && mv -f "$ST.tmp" "$ST"; }
log() { echo "$(date) $*" >> "$LOG"; }
fail() { log "copy failed: $*"; status error "$*"; exit 1; }
card_install() {
	! grep -q 'root=mtd:' "$CMDLINE" && [ -f "$SD/rootfs.sqfs" ] && [ -f "$SD/nor/kernel.itb" ] &&
		[ -f "$SD/nor/u-boot-sunxi-with-spl.bin" ] && grep -q '"rootfs"' "$MTD" 2>/dev/null
}
sha() { sha256sum | cut -d' ' -f1; }

case "${1:-}" in
status)
	if ! card_install; then rm -f "$ST"; exit 0; fi
	if "$NOR" stock; then status stock; else status ready; fi
	;;
copy)
	card_install || fail "this is not a card install with the built-in flash's files (nor/)"
	mkdir "$RUN/dash-nor.lock" 2>/dev/null || { echo "dash-nor: a copy is running" >&2; exit 1; }
	trap 'rmdir "$RUN/dash-nor.lock"' EXIT
	log "copy: $(cat /etc/image-id 2>/dev/null) to the built-in flash"
	if "$NOR" stock; then
		CHIP=$(awk '$2 == "01000000" { sub(":", "", $1); print "/dev/" $1; exit }' "$MTD")
		if [ ! -f "$SD/stock.bin" ] || [ "$(sha < "$SD/stock.bin")" != "$(sha < "$CHIP")" ]; then
			status copying "saving the stock firmware to the card"
			"$NOR" read "$SD/stock.bin.new" >> "$LOG" 2>&1 || { rm -f "$SD/stock.bin.new"; fail "the stock firmware could not be saved (is the card full?)"; }
			mv -f "$SD/stock.bin.new" "$SD/stock.bin" && sync
		fi
	fi
	status copying "writing the built-in flash"
	ROOTFS="$SD/rootfs.sqfs" STOCK="$SD/stock.bin" "$NOR" flash "$SD/nor" >> "$LOG" 2>&1 ||
		fail "the built-in flash could not be written: the card still starts the screen"
	status copying "copying the settings"
	"$NOR" seed >> "$LOG" 2>&1 || fail "the settings could not be copied: the system is on the built-in flash"
	log "copy: done"
	status done
	;;
*)
	echo "usage: dash-nor {status|copy}" >&2
	exit 2
	;;
esac
