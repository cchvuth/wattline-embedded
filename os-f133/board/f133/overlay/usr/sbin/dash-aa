#!/bin/sh
# dash-aa start|extra|restore|stop|forget: wireless Android Auto on demand on the F133 screen (SRNUBI T313D), from the
# dash's AA button (the T113 Dash's dash-aa, for this hardware). It stays on across restarts: /data/aa-on is written once
# it is up (its line: the mode) and removed by stop, and the dash runs `restore` at its start while the file is there: as
# start (or extra), but without the 2-minute pairing window (nobody tapped). /run/dash-aa marks it up, for the button.
# extra: the same AP for an addition kept outside this repository instead of Android Auto (the dash's second button,
# shown only with /data/hooks/extra-start and its icon there): its hook, not the receiver or the Bluetooth start, on a
# network of its own (SSID WattlineAA, the unit's kept passphrase), so a device that remembers that network never joins
# an Android Auto session's (SSID Wattline, a fresh passphrase). /run/dash-aa.extra marks that mode up. Either mode
# started while the other is up takes its place.
#
# Up: a 5 GHz AP for the phone (ch36, WPA2-PSK), the receiver (aa serve: TCP 5288 + TLS, the picture into the split
# view's region through spike-vdec) and the Bluetooth start (aa mcu). This screen's classic Bluetooth is its power MCU,
# whose firmware owns the Android Auto RFCOMM service: mcud (S03mcu) hands aa the channel when the phone opens it, and aa
# gives the phone the AP's address and credentials there. The phone has to be paired with the screen's Bluetooth: start
# opens a 2-minute window for that. A phone paired before is dropped while Android Auto is off (mcud: it would retry
# Android Auto for as long as it stays on the MCU's Bluetooth; auto-connect goes off with it) and called back at the
# next start (auto-connect on, AT#MG; AT#CC, the last device, when no phone is connected: mcud's /run/mcud.phone).
#
# The radio, as the T113: the station's link is dropped for the session (wpa_cli disconnect, reconnect at stop) so the
# one radio serves the AP alone on its channel; the car link rides the Commander's Bluetooth meanwhile. The AP gets an
# interface of its own (ap0, beside wlan0); if ap0 cannot be made or its AP does not start, or with /data/wifi/aa-solo,
# the AP takes wlan0 and the station stops until stop. Either way a settings save
# waits for stop (/run/dash-aa-radio): wifi-connect restarts every wpa_supplicant, the AP's included. The country, the
# device's own setting (two letters), comes from /data/wifi/country if there.
#
# The head-unit certificate is user-supplied at /etc/wattline/aa.{crt,key}; without a usable one start refuses (and the
# dash hides the button).
MODE=aa   # (or extra: start's case below)
[ "$1" = extra ] && MODE=extra
[ "$1" = restore ] && [ "$(head -n 1 /data/aa-on 2>/dev/null)" = extra ] && MODE=extra
[ "$MODE" = extra ] && [ ! -x /data/hooks/extra-start ] && MODE=aa   # its addition gone: Android Auto
if [ "$MODE" = extra ]; then SSID=${SSID:-WattlineAA}; else SSID=${SSID:-Wattline}; fi
XMARK=/run/dash-aa.extra
up_mode() { [ -e $XMARK ] && echo extra || echo aa; }
# A fresh random passphrase each session: a fixed one would be in this public repo. The phone needs no setup for it:
# it gets the passphrase over Bluetooth (the paired AA channel) every time it connects. For extra, this unit's own, the
# same every session, where one is kept on it (/data/wattline/ap-psk, root only: 8 to 63 letters and digits on its first
# line, put there by whoever wants the network to stay the one a device was given; never in this repo, never printed).
ap_psk() {
	p=; [ "$MODE" = extra ] && p=$(head -n 1 /data/wattline/ap-psk 2>/dev/null | tr -d '\r')
	case "$p" in *[!0-9A-Za-z]*) p= ;; esac
	if [ ${#p} -ge 8 ] && [ ${#p} -le 63 ]; then printf %s "$p"; else od -An -tx1 -N10 /dev/urandom 2>/dev/null | tr -d ' \n'; fi   # 20 hex digits
}
PSK=${PSK:-}
IP=${IP:-192.168.53.1}   # the AP's /24: not the car's 192.168.4.x, nor a phone hotspot's 192.168.43.x
CERT=/etc/wattline/aa.crt
MARK=/run/dash-aa

# The session's logs, in $LOG: the boot's log folder (S02sd: /data/log/<boot> with Save logs on, else nowhere).
# (a log folder that cannot be written: in RAM then; the shell runs nothing whose log cannot be opened, and ends on a
# ":" whose redirection fails)
LOG=/var/log/sd; ( : >> $LOG/aa-ap.log ) 2>/dev/null || LOG=/tmp
# Hooks for additions kept outside this repository (absent on a plain image), output in $LOG/hook-<name>.log:
#  - /data/hooks/extra-start: extra's, once the access point is up (Android Auto's start runs none). Gets IFACE, SSID,
#    PSK and IP. (A helper may take a channel of its own from mcud, on /run/mcud.sock.) Its button's icon:
#    /data/hooks/extra-icon (the dash's).
#  - /data/hooks/extra-stop: at every stop (also after a failed start, or with no session up), so it must be safe to
#    repeat. Gets IFACE and IP.
# Each has 10 s, then SIGTERM, and SIGKILL 2 s later (the hook's own process: a daemon it started lives on).
hook() {
	[ -x "/data/hooks/$1" ] || return 0
	if [ "$1" = extra-start ]; then IFACE=$IFACE SSID=$SSID PSK=$PSK IP=$IP "/data/hooks/$1" >"$LOG/hook-$1.log" 2>&1 & _hp=$!
	else IFACE=$IFACE IP=$IP "/data/hooks/$1" >"$LOG/hook-$1.log" 2>&1 & _hp=$!; fi
	( sleep 10; kill $_hp; sleep 2; kill -9 $_hp ) >/dev/null 2>&1 & _hk=$!
	wait $_hp; kill $_hk 2>/dev/null; return 0
}
# The station's link down for the session: its wpa_supplicant (the only one on wlan0's default control socket; the AP's is
# /run/aa-ap) asked to disconnect until it reports so, 10 s at the most; none answering: no station to drop
station_off() {
	_i=0
	while [ $_i -lt 10 ]; do
		case $(wpa_cli -i wlan0 status 2>/dev/null | sed -n 's/^wpa_state=//p') in
		'') pidof wpa_supplicant >/dev/null || return 0 ;;   # (one starting: asked again in a second)
		DISCONNECTED|INACTIVE|INTERFACE_DISABLED) return 0 ;;
		*) wpa_cli -i wlan0 disconnect >/dev/null 2>&1 ;;
		esac
		sleep 1; _i=$((_i + 1))
	done
	echo "dash-aa: the station did not let go of its network" >&2
}

# The AP on $IFACE: wpa_supplicant's AP mode (no hostapd in this image), an instance of its own (control: /run/aa-ap),
# up once it says so (<= 10 s); then its address and DHCP (busybox udhcpd). The lease table starts empty each time: a
# phone can show a new random MAC per join, and a full table means no offer (AA stuck at "connecting").
ap_up() {
	( umask 077; printf 'ctrl_interface=/run/aa-ap\nap_isolate=1\nnetwork={\n\tmode=2\n\tssid=%s\n\tfrequency=5180\n\tkey_mgmt=WPA-PSK\n\tproto=RSN\n\tpairwise=CCMP\n\tgroup=CCMP\n\tpsk="%s"\n}\n' \
		"$(printf %s "$SSID" | xxd -p | tr -d '\n')" "$PSK" > /run/aa-ap.conf )
	( : > $LOG/aa-ap.log ) 2>/dev/null
	wpa_supplicant -B -i "$IFACE" -D nl80211 -c /run/aa-ap.conf -P /run/aa-ap.pid -f $LOG/aa-ap.log || return 1
	i=0; until wpa_cli -p /run/aa-ap -i "$IFACE" status 2>/dev/null | grep -q '^wpa_state=COMPLETED'; do
		[ $i -lt 20 ] || return 1; usleep 500000; i=$((i + 1)); done
	ip addr flush dev "$IFACE"
	ip addr add "$IP/24" dev "$IFACE" || return 1
	B=${IP%.*}
	printf 'interface %s\nstart %s.10\nend %s.200\nmax_leases 190\nlease_file /run/aa-udhcpd.leases\npidfile /run/aa-udhcpd.pid\noption subnet 255.255.255.0\noption lease 3600\n' \
		"$IFACE" "$B" "$B" > /run/aa-udhcpd.conf
	: > /run/aa-udhcpd.leases
	udhcpd -f -a 100 /run/aa-udhcpd.conf > $LOG/aa-udhcpd.log 2>&1 &   # -a: a 100 ms ARP probe, not 2 s (the phone gives up waiting)
}
ap_down() {   # the AP's wpa_supplicant and DHCP gone (<= 5 s), its address, and ap0 (also a half-made AP)
	# the phones on it told first, while the AP still sends: a deauthentication each. Stopped as it was, the AP went
	# quiet before it let them go, and a phone could stay on the network for a while, waiting for it to come back
	if [ -n "$IFACE" ] && [ -S "/run/aa-ap/$IFACE" ]; then
		_sent=
		for _m in $(wpa_cli -p /run/aa-ap -i "$IFACE" all_sta 2>/dev/null | grep -E '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'); do
			wpa_cli -p /run/aa-ap -i "$IFACE" deauthenticate "$_m" >/dev/null 2>&1 && _sent=1
		done
		# the frames delivered before the AP goes: a phone that dozes (some listen only every 20 beacons, ~2 s) gets
		# its deauthentication only when it wakes; gone sooner, it stayed ~20 s, waiting for the quiet AP to come back
		[ -n "$_sent" ] && usleep 2000000
	fi
	p=$(cat /run/aa-ap.pid 2>/dev/null)
	[ -n "$p" ] && kill "$p" 2>/dev/null
	killall -q udhcpd
	i=0; while { [ -n "$p" ] && [ -d "/proc/$p" ]; } || pidof udhcpd >/dev/null; do
		[ $i -lt 25 ] || { [ -n "$p" ] && kill -9 "$p" 2>/dev/null; killall -q -9 udhcpd; break; }
		usleep 200000; i=$((i + 1))
	done
	rm -f /run/aa-ap.pid /run/aa-ap.conf /run/aa-udhcpd.conf /run/aa-udhcpd.pid /run/aa-udhcpd.leases
	[ -n "$IFACE" ] && ip addr del "$IP/24" dev "$IFACE" 2>/dev/null
	[ -e /sys/class/net/ap0 ] && iw dev ap0 del 2>/dev/null
}
# New phones pair only in the 2 minutes after the button (someone at the screen), not for the whole session: Bluetooth
# on (AT#CA; S03mcu also sends it at boot), each pairing request it reports (AP<code>) accepted (AT#KA). Never AT#CB: it
# turns the MCU's Bluetooth off (the phone dropped, the screen gone from its list), not just hidden.
# Its own process group: stop ends all of it.
pair_on() {
	setsid sh -c '{ echo "AT#CA"; sleep 120; } | mcud ctl 121 |
		while read -r l; do case $l in AP*) printf "AT#KA\n" | mcud ctl 1 ;; esac; done
		rm -f /run/aa-pair.pid' >/dev/null 2>&1 &   # (its pid file with it: stop must not signal a later group of that number)
	echo $! > /run/aa-pair.pid
}
pair_off() {   # a window still open: ended (Bluetooth stays on)
	p=$(cat /run/aa-pair.pid 2>/dev/null); rm -f /run/aa-pair.pid
	[ -n "$p" ] && kill -- -"$p" 2>/dev/null
}
stop() {
	# The receiver told to stop at once: it says goodbye to the phone and the picture goes (aa mcu too, so the phone's
	# channel is let go and it stops redialling the AP's session). The hook runs beside it, not before it: both need
	# the AP, which stays until the hook is done (<= 12 s) and the receiver has ended its session (its marker gone: the
	# phone told), or had 3 s for it. Then the phones are told to leave (ap_down): one after the other, this took a
	# phone ~8 s to drop the Wi-Fi.
	rm -f /run/aa-keep   # first: the receiver and the Bluetooth start are not started again (their loops, start)
	killall aa spike-vdec 2>/dev/null
	# the rest behind the dash: it repaints the whole screen now, on the one core this script and its helpers share
	# (at equal priority the repaint crawled down the screen for a second)
	renice 10 -p $$ >/dev/null 2>&1
	IFACE=$(cat /run/aa-ap.iface 2>/dev/null)   # the hook gets it too
	hook extra-stop & _hs=$!
	pair_off
	i=0; while [ -e /run/dash-aa-session ] && [ $i -lt 15 ]; do usleep 200000; i=$((i + 1)); done   # <= 3 s
	wait $_hs
	killall aa spike-vdec 2>/dev/null   # again: a helper may have restarted them
	rm -f /run/aa-ap.iface
	ap_down
	i=0; while pidof aa spike-vdec >/dev/null 2>&1 && [ $i -lt 10 ]; do usleep 200000; i=$((i + 1)); done   # <= 2 s more
	killall -9 spike-vdec aa 2>/dev/null
	rm -f /run/dash-project /run/dash-aa-session /run/dash-aa-focus /run/dash-pj-fps   # aa serve's and the decoder's, if killed mid-session
	rm -f $XMARK "$MARK" /run/dash-aa-radio   # before Wi-Fi comes back (S45wifi-auto waits while they are there); the button off
	renice 0 -p $$ >/dev/null 2>&1   # (the station's wpa_supplicant and DHCP, started below, at the usual priority)
	# the station: a list saved meanwhile (and the network picked, if one was), or back if the AP took wlan0
	if [ -e /run/wifi-auto.pending ]; then
		J=$(head -n 1 /run/wifi-auto.pending); rm -f /run/wifi-auto.pending; /etc/init.d/S45wifi-auto start "$J" >/dev/null 2>&1
	elif [ "$IFACE" = wlan0 ] || ! pidof wpa_supplicant >/dev/null; then
		/etc/init.d/S45wifi-auto start >/dev/null 2>&1
	else
		# the station's link, dropped at start (as the T113); its daemon not answering: started anew
		wpa_cli -i wlan0 reconnect >/dev/null 2>&1 || /etc/init.d/S45wifi-auto start >/dev/null 2>&1
	fi
}

case "$1" in
start|extra|restore)
	if [ $MODE = aa ]; then   # (Android Auto's own: extra's addition has its own credentials)
		[ -f "$CERT" ] || { echo "dash-aa: no head-unit certificate at $CERT" >&2; exit 1; }
		aa certcheck "$CERT" "${CERT%.crt}.key" || exit 1   # self-signed, or its key missing/another's: no session (it says why)
	fi
	[ -n "$PSK" ] || PSK=$(ap_psk)
	[ ${#PSK} -ge 8 ] || { echo "dash-aa: could not make the AP passphrase" >&2; exit 1; }
	[ -f "$MARK" ] && [ "$(up_mode)" = $MODE ] && exit 0   # already up
	# one start at a time (a boot restore, or a tap once the UI stops waiting on this one at 90 s): the lock
	# holds its start's pid; one whose start died (no such process) is taken over. Not by age: the clock jumps at boot.
	L=/run/dash-aa.starting
	if ! mkdir $L 2>/dev/null; then
		p=$(cat $L/pid 2>/dev/null); [ -n "$p" ] || { sleep 1; p=$(cat $L/pid 2>/dev/null); }   # made, pid not written yet
		[ -n "$p" ] && kill -0 "$p" 2>/dev/null && { echo "dash-aa: already starting" >&2; exit 0; }
		rm -rf $L; mkdir $L 2>/dev/null || { echo "dash-aa: already starting" >&2; exit 0; }
	fi
	echo $$ > $L/pid
	trap 'rm -rf /run/dash-aa.starting' EXIT
	if [ -f "$MARK" ]; then
		[ "$(up_mode)" = $MODE ] && exit 0   # up by the start that held the lock
		# the other mode: down first (its marks with it), this one in its place; not on again at the next start
		# until this one is up (a switch that fails, or a power cut in it, leaves nothing to restore)
		rm -f /data/aa-on; sync; stop
	fi
	# first: from here a settings save waits for stop (S45wifi-auto), never restarting wpa_supplicant under the AP. Under
	# the Wi-Fi lock, so a join already past its check finishes first
	# (90 s: a boot's S45wifi-auto holds it while the driver's wlan0 comes and wifi-connect runs, ~45 s at the most; gone
	# ahead without it, that join could start the station, or kill every wpa_supplicant, under this start's AP)
	i=0; got=; until mkdir /run/wifi-auto.lock 2>/dev/null && got=1; do [ $i -ge 90 ] && break; sleep 1; i=$((i+1)); done
	: > /run/dash-aa-radio
	[ -n "$got" ] && rmdir /run/wifi-auto.lock
	for i in $(seq 1 40); do [ -e /sys/class/net/wlan0 ] && break; sleep 1; done   # a restore at boot: the driver's wlan0
	# (the dash starts first, S05dash; the driver loads after it, in the background, ~5 s: S05wifi)
	# as the T113: the station's link dropped for the session, so the radio serves the AP alone on its own channel (one
	# radio hopping between the car's Wi-Fi and the AP's channel dropped the phone); during AA the car link rides the
	# Commander's Bluetooth. wpa_cli disconnect holds until reconnect (stop): no auto-rejoin fighting the AP. Asked until
	# the station says so (10 s): one whose wpa_supplicant was still starting (a restore at boot) did not hear a single ask
	station_off
	# the kernel's rules for the device's country (wireless-regdb; the boot's load came before the root was there)
	CC=$(cat /data/wifi/country 2>/dev/null | tr -dc A-Za-z | tr a-z A-Z)
	[ ${#CC} = 2 ] && { iw reg reload 2>/dev/null; iw reg set "$CC"; }
	# per-session logs (the one before kept as .1): aa-ap, aa-udhcpd, aa-serve, aa-mcu
	# the session before kept as *.log.1: a session that ended badly is usually looked at after the phone reconnected
	for f in aa-ap aa-udhcpd aa-serve aa-mcu; do [ -f $LOG/$f.log ] && mv -f $LOG/$f.log $LOG/$f.log.1; done
	IFACE=
	if [ ! -e /data/wifi/aa-solo ] && iw dev wlan0 interface add ap0 type __ap 2>/dev/null; then
		IFACE=ap0
		ap_up || { echo "dash-aa: no AP beside the station: the AP takes wlan0" >&2; ap_down; IFACE=; }
	fi
	if [ -z "$IFACE" ]; then
		IFACE=wlan0
		echo wlan0 > /run/aa-ap.iface   # (stop brings the station back)
		[ -f /run/wpa_cli.loop ] && kill "$(cat /run/wpa_cli.loop)" 2>/dev/null; rm -f /run/wpa_cli.loop   # (wifi-connect's)
		killall -q wpa_cli udhcpc wpa_supplicant   # the station off until stop
		i=0; while pidof wpa_supplicant >/dev/null && [ $i -lt 10 ]; do sleep 1; i=$((i+1)); done
		ap_up || { echo "dash-aa: the AP did not come up ($LOG/aa-ap.log)" >&2; stop; exit 1; }
	fi
	echo $IFACE > /run/aa-ap.iface
	BSSID=$(cat /sys/class/net/$IFACE/address)
	echo "dash-aa: AP on $IFACE ($BSSID) ssid=$SSID ip=$IP"
	# The AP carries live video: the radio out of power save for the session (latency, not a correctness fix)
	iw dev "$IFACE" set power_save off 2>/dev/null; iw dev wlan0 set power_save off 2>/dev/null
	[ $MODE = extra ] && hook extra-start
	# The receiver (on the AP's address only) and the Bluetooth start, each started again if it dies while the session
	# is on (/run/aa-keep, holding this start's pid: stop removes it first; a session that took the place of this one
	# writes its own, so this one's loops, asleep through that stop, end rather than start Android Auto in it), 20 times at most. A receiver that died mid-session left its markers:
	# the split showed its last picture for good; they go with it.
	echo $$ > /run/aa-keep
	keep() { [ "$(cat /run/aa-keep 2>/dev/null)" = $$ ]; }   # ($$: this start's, in its subshells too)
	[ $MODE = aa ] && ( n=0; while keep && [ $n -lt 20 ]; do
		( : >> $LOG/aa-serve.log ) 2>/dev/null || LOG=/tmp   # (the card gone read-only meanwhile: not without the receiver)
		AA_LISTEN=$IP aa serve >> $LOG/aa-serve.log 2>&1   # listening before aa mcu sends any phone to it
		rm -f /run/dash-project /run/dash-aa-session /run/dash-aa-focus /run/dash-pj-fps
		keep && sleep 1; n=$((n + 1))
	done ) &
	# the passphrase on its stdin, not in its arguments (any process can read those); printf is the shell's own
	[ $MODE = aa ] && ( n=0; while keep && [ $n -lt 20 ]; do
		( : >> $LOG/aa-mcu.log ) 2>/dev/null || LOG=/tmp
		printf '%s\n' "$PSK" | aa mcu "$IP" "$SSID" - "$BSSID" >> $LOG/aa-mcu.log 2>&1
		keep && sleep 2; n=$((n + 1))
	done ) &
	# the MCU's auto-connect on again (mcud turns it off when it drops a phone while Android Auto is off, and the MCU may
	# keep it off across starts) and, for Android Auto with no phone connected (mcud's /run/mcud.phone), the phone called
	# back (the MCU's last device) once aa mcu is waiting for it. Not for extra: the last device is likely the Android
	# phone, not the one extra's addition wants
	cc=; [ $MODE = aa ] && [ ! -e /run/mcud.phone ] && cc='AT#CC'
	( sleep 1; printf 'AT#MG\n%s\n' "$cc" | mcud ctl 1 >> $LOG/aa-mcu.log 2>&1 ) &
	[ "$1" != restore ] && pair_on   # someone at the screen tapped it (not a restore at boot)
	# up: on again at the next start, in this mode (the dash restores it), until stopped. (printf, not `: >`: a failed
	# redirect on a special builtin would end the script before the marker)
	printf '%s\n' $MODE > /data/aa-on 2>/dev/null && sync
	[ $MODE = extra ] && touch $XMARK
	touch "$MARK"
	# A stop that came meanwhile (the split's Exit, a phone already on it; the sync above is the slow step) took it all
	# down and its marks away: not left marked up after it, nor on at the next start, nor with its pairing window open.
	# (Looked at after the marks are made: stop removes aa-keep before it removes them.)
	# The mark itself goes only when that stop has ended (it removes dash-aa-radio last, with the mark): until then the
	# button stays "stopping" and this start keeps its lock, so no second start runs into the stop's teardown.
	if [ ! -e /run/aa-keep ]; then
		rm -f /data/aa-on; sync; pair_off
		i=0; while [ -e /run/dash-aa-radio ] && [ $i -lt 90 ]; do usleep 500000; i=$((i + 1)); done
		rm -f $XMARK "$MARK"; exit 0
	fi
	;;
stop)   # the user's stop (the button, the split's Exit): off, and off at the next start too (first: a power cut
	# during the seconds stop takes must not bring it back)
	# (aa-keep before it: a start in its last moments then sees this stop, where it wrote aa-on back during this sync)
	rm -f /run/aa-keep
	rm -f /data/aa-on 2>/dev/null && sync || echo "dash-aa: /data/aa-on not removed: AA comes back at the next start" >&2
	stop ;;
forget)   # the T113's "forget the paired phones": here the pairings are the MCU's own, with no list it gives out
	echo "dash-aa: forget: this screen's Bluetooth (its MCU) keeps its own pairings" >&2; exit 1 ;;
*)
	echo "usage: dash-aa start|extra|restore|stop|forget" >&2; exit 2 ;;
esac
