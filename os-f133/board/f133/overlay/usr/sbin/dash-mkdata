#!/bin/sh
# dash-mkdata: run once, at the first start of a card fresh from its image (S01data). Adds the writable partition p2
# (Linux type, ext4 labelled WATTDATA: /data) over the card's free space after p1, leaving p1 (FAT: the system,
# mounted) as it is. Refuses unless the card has an MBR with exactly p1 and room after it. p1 (start, size, type) and
# the disk id are compared before and after the table is written: any change, it stops before mkfs. p1 stays mounted
# (the root runs from it), so the table is not re-read: the kernel is given p2 alone (partx, BLKPG); where it does not
# take it, the next start finds p2 and S01data makes its filesystem.
die() { echo "dash-mkdata: $*" >&2; exit 1; }
D=${DATA_CARD:-/dev/mmcblk0}
[ -b $D ] || die "no SD card"
N=${D##*/}
[ -e ${D}p2 ] && die "${D}p2 exists already: nothing to do"
[ "$(blockdev --getro $D)" = 0 ] || die "$D is read-only"
[ "$(blockdev --getss $D)" = 512 ] || die "sector size not 512"
B=$(sfdisk -d $D) || die "sfdisk -d failed"
echo "$B" | grep -qx 'label: dos' || die "not an MBR card"
[ "$(echo "$B" | grep -c "^/dev/")" = 1 ] && echo "$B" | grep -q "^${D}p1 :" || die "expected exactly ${D}p1"
keep() { echo "$1" | grep -E "^(label-id:|${D}p1 :)"; }
K0=$(keep "$B")
t=$(echo "$B" | sed -n "s|^${D}p1 : start= *\([0-9]*\), size= *\([0-9]*\),.*|\1 \2|p")
[ "$t" = "$(cat /sys/block/$N/${N}p1/start) $(cat /sys/block/$N/${N}p1/size)" ] || die "${D}p1: table and kernel differ"
set -- $t
S=$(( ($1 + $2 + 2047) / 2048 * 2048 ))   # 1 MiB aligned, right after p1
T=$(blockdev --getsz $D)
Z=$((T - S))
[ $Z -ge 524288 ] || die "no room: $Z sectors after p1 (256 MiB at least)"
echo "== p2: start=$S size=$Z type=83 (card $T sectors)"
echo "start=$S, size=$Z, type=83" | sfdisk --no-reread --wipe never --wipe-partitions never --append $D >/dev/null 2>&1 ||
	die "sfdisk --append failed"
partx -a -n 2 $D 2>/dev/null
i=0; until [ -b ${D}p2 ] || [ $i -ge 10 ]; do sleep 1; i=$((i+1)); done
K1=$(keep "$(sfdisk -d $D)")
[ "$K0" = "$K1" ] || { echo "before:"; echo "$K0"; echo "after:"; echo "$K1"; die "p1 or the disk id changed: STOP, no mkfs"; }
sfdisk -d $D | grep -q "^${D}p2 : start= *$S, size= *$Z, type=83" || die "p2 is not in the table as it was put"
[ -b ${D}p2 ] || die "${D}p2 is in the table, not yet in the kernel: its filesystem comes at the next start (S01data)"
[ "$(cat /sys/block/$N/${N}p2/start) $(cat /sys/block/$N/${N}p2/size)" = "$S $Z" ] || die "${D}p2 is not where it was put"
# a card flashed again over an earlier one: its WATTDATA is still there, at the same place, and never made again here
# (S01data checks and mounts it, or leaves /data in RAM: someone's settings and recordings are not wiped for an e2fsck
# that failed, perhaps only for want of memory). mkfs without the discard and with lazy initialisation: seconds, not
# minutes, on a big card at the first start (before mcud holds the power, before the dash shows)
# (any ext superblock counts, by its magic as S01data looks for it: not only one blkid reads as WATTDATA)
m=$(dd if=${D}p2 bs=2 skip=540 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')
if [ "$m" = 53ef ] || blkid ${D}p2 2>/dev/null | grep -q 'LABEL="WATTDATA"'; then
	echo "== ${D}p2: an earlier WATTDATA: kept (S01data checks it)"
else
	mkfs.ext4 -F -q -E nodiscard,lazy_itable_init=1,lazy_journal_init=1 -L WATTDATA ${D}p2 </dev/null || die "mkfs.ext4 failed"
	e2fsck -fn ${D}p2 >/dev/null || die "e2fsck after mkfs failed"
fi
[ "$K0" = "$(keep "$(sfdisk -d $D)")" ] || die "p1 changed"
echo "dash-mkdata: done, p1 unchanged"
