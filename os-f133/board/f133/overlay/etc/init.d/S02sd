#!/bin/sh
# The logs and the swap file, once /data is there (S01data: the card's ext4 partition). No console is wired out, so
# with "Save logs" on (Settings, Advanced; save_logs in /data/settings.conf) everything worth knowing goes to
# /data/log/<boot>/ (/var/log/sd links there), every 5 s; the 30 latest boots' folders are kept, and in the running
# boot's the files others append to (dash.out, wpa.txt, wifi.txt, mcu.txt) are copied to <name>.1 and emptied once past
# 1 MiB. syslog has its own rotation (/etc/default/syslogd), the dash's log and drive recordings (/data/rec) theirs
# (dash.conf). Off, the default: no logs at all, on the card or in RAM: /var/log/sd and /data/log are nolog's read-only
# folder of links to /dev/null, no boot folder, no kernel log copy, no state every 5 s. A change counts from the next
# start. The card's first partition (FAT: the system) is the initramfs's, checked and repaired before it is mounted
# (/init's card_fsck); should it be gone, the backlight (PG15) flashes at 4 Hz for good.
bl() {
	v=$(devmem 0x02000130 32 2>/dev/null) && [ -n "$v" ] || return 0
	if [ "$1" = on ]; then devmem 0x02000130 32 $((v | 0x8000)); else devmem 0x02000130 32 $((v & ~0x8000)); fi
}
sz() { set -- $(ls -ln "$1" 2>/dev/null) 0 0 0 0 0; echo $5; }   # a file's size without reading it (no stat here)

case "$1" in
start)
	# (only onto the card's ext4 /data: in RAM they would fill the 64 MiB, so none then)
	logs=; grep -qE '^save_logs *= *1' /data/settings.conf 2>/dev/null && grep -q '^[^ ]* /data ext4 ' /proc/mounts && logs=1
	if [ -z "$logs" ]; then
		nolog /run/nolog && ln -sfn /run/nolog /var/log/sd
		mkdir -p /data/log 2>/dev/null && mount -o bind /run/nolog /data/log   # (the dash's, Android Auto's)
	fi
	if ! grep -q " /mnt/sd " /proc/mounts; then
		(while :; do bl off; usleep 125000; bl on; usleep 125000; done) &
		exit 0
	fi
	# a swap file on /data, if one was made there (dd, 64 MiB): a safety net for memory spikes on 64 MiB, not working
	# memory; swappiness 10 drops cached files before paging anything out (none while /data is in RAM)
	if [ -f /data/swapfile ] && grep -q " /data ext4 " /proc/mounts; then
		swapon /data/swapfile 2>/dev/null || { mkswap /data/swapfile >/dev/null && swapon /data/swapfile; }
		echo 10 > /proc/sys/vm/swappiness
	fi
	[ -n "$logs" ] || exit 0
	mkdir -p /data/log
	n=$(cat /data/log/bootcount 2>/dev/null)
	case $n in ''|0?*|*[!0-9]*) n=0 ;; esac   # none, or garbage: 0, not an arithmetic error
	n=$((n + 1))
	echo $n > /data/log/bootcount
	L=/data/log/$n
	mkdir -p $L
	ln -sfn $L /var/log/sd
	for d in /data/log/*; do   # older than the 30 latest boots: gone
		b=${d##*/}; case $b in ''|*[!0-9]*) continue ;; esac
		[ $b -le $((n - 30)) ] && rm -rf "$d"
	done
	# The kernel's log: each record once, appended as it comes (/dev/kmsg). The state (memory, addresses, processes)
	# is in RAM, /run/state.txt, every 5 s, and in the log folder once a minute.
	# (one open file for every cat: after an overrun the next goes on from where the log still holds, not from its start)
	( exec 3< /dev/kmsg; while :; do cat <&3; sleep 1; done >> $L/dmesg.txt 2>/dev/null ) &
	(
		k=0
		while :; do
			# (the clocks this start runs at: the SPL's count of its starts since the power came on, a start after a
			# reset being at the stock ones; the CPU's and the memory's PLL registers, the CPU's clock as the kernel has it)
			{ cat /proc/uptime; cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null
			  echo "starts $(devmem 0x07090118 32) PLL_CPU $(devmem 0x02001000 32) PLL_DDR $(devmem 0x02001010 32) cpu $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq) kHz"
			  free; ip addr; ip route; iw dev; ps; } > /run/state.txt 2>&1
			[ $k = 0 ] && cp /run/state.txt $L/state.txt
			k=$(((k + 1) % 12))
			for f in $L/dash.out $L/wpa.txt $L/wifi.txt $L/mcu.txt $L/dmesg.txt; do   # appended to (O_APPEND): emptied in place, the writer goes on
				[ "$(sz $f)" -gt 1048576 ] && cp $f $f.1 && ( : > $f ) 2>/dev/null
			done
			sync
			sleep 5
		done
	) &
	;;
esac
