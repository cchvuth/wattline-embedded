# the board
CONFIG_ARCH_SUNXI=y
CONFIG_ERRATA_THEAD=y
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_PWRSEQ_SIMPLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SUNXI_WATCHDOG=y
CONFIG_PRINTK_TIME=y
CONFIG_PANIC_TIMEOUT=5
# the console through OpenSBI (SBI v0.1 putchar; 6.6 has no DBCN console): OpenSBI keeps a copy in DRAM
# (0x43b00000, reserved in the device tree), which U-Boot's SPL puts on the card after a reset
CONFIG_RISCV_SBI_V01=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
# the kernel log kept in RAM across the reset (ramoops@43800000 in the device tree)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# CONFIG_PSTORE_COMPRESS is not set
# userspace: an initramfs, the card's FAT partition, modules (the Wi-Fi driver is out of tree)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# Wi-Fi (the AIC8800D driver is a full-MAC cfg80211 driver)
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_WLAN=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
# 64 MiB of RAM. The flat memory model: SPARSEMEM's section table alone takes 16 MiB on riscv64 (MAX_PHYSMEM_BITS 56),
# which left too little to unpack the initramfs (seen in QEMU with -m 64M: "Initramfs unpacking failed: write error",
# then a panic). No 2 MiB alignment of the kernel image's sections either (STRICT_KERNEL_RWX), another ~6 MiB.
CONFIG_FLATMEM_MANUAL=y
# CONFIG_SPARSEMEM_MANUAL is not set
# CONFIG_STRICT_KERNEL_RWX is not set
# none of these are on the board or used
# CONFIG_ACPI is not set
# CONFIG_EFI is not set
# CONFIG_AUDIT is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_MD is not set
# CONFIG_HUGETLBFS is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_SOUND is not set
# CONFIG_PCI is not set
# USB: these lines replace the USB_SUPPORT "is not set" line of linux.fragment.
# Host: EHCI/OHCI (PHY0 routes the phone port to EHCI0/OHCI0 in host mode); usbfs (/dev/bus/usb/BBB/DDD from
# devtmpfs) is part of usbcore, no option. Device side for a wired phone link: the musb in dual role (the
# musb-hdrc.*.auto/mode switch needs DUAL_ROLE, which needs USB_GADGET=y), configfs gadgets with NCM (an IP link)
# and FunctionFS (an interface served by userspace). USB_HID defaults to y and selects HID, which the
# board keeps off: no kernel driver should take the phone's HID interface. The riscv defconfig (Buildroot's base)
# turns on xHCI, which the D1s has not; its musb/PHY "m" become "y" here.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_SUNXI=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_F_FS=y
# CONFIG_USB_HID is not set
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_NET_9P is not set
# CONFIG_NFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_KVM is not set
# CONFIG_ETHERNET is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_HID is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_SOC_MICROCHIP_POLARFIRE is not set
# CONFIG_SOC_SIFIVE is not set
# CONFIG_SOC_STARFIVE is not set
# CONFIG_SOC_VIRT is not set
# CONFIG_ARCH_CANAAN is not set
# the display (as on the T113 Dash): DE2 mixer -> TCON LCD -> MIPI-DSI, the dash panel driver (patches/linux), fbdev
# for the dash program and a rotated text console for the boot messages; CMA for the 720x1920 framebuffer
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN6I_DSI=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
# CONFIG_DRM_SUN4I_HDMI is not set
# CONFIG_DRM_SUN4I_BACKEND is not set
# CONFIG_DRM_SUN8I_DW_HDMI is not set
CONFIG_PHY_SUN6I_MIPI_DPHY=y
CONFIG_DRM_PANEL_DASH_DSI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GPIO=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_SUN8I=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
# built in, not modules: the DE2 clocks give the mixer its reset line (as a module the display never bound),
# the I2C controller (touch on I2C3), the DMA engine; GPIO lines from the shell for bring-up
CONFIG_SUN8I_DE2_CCU=y
CONFIG_I2C_MV64XXX=y
CONFIG_I2C_CHARDEV=y
CONFIG_DMA_SUN6I=y
CONFIG_GPIO_SYSFS=y
# the root filesystem from the card, not RAM: a built-in initramfs whose /init loop-mounts rootfs.sqfs (squashfs,
# lz4: quick to read on the C906) from the F133 partition under a tmpfs overlay
CONFIG_INITRAMFS_SOURCE="/ext/board/f133/initramfs.list"
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_OVERLAY_FS=y
# the panel's touch (patches/linux/0004), read by the dash through evdev
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_JD9366T=y
# the video engine: cedrus, the V4L2 stateless decoder (/dev/video0 + /dev/media0), for Android Auto's H.264 (as the
# Dash R4). Goes into board/f133/linux.fragment, replacing its MEDIA_SUPPORT "is not set" line and its CMA size of 8.
CONFIG_MEDIA_SUPPORT=y
# EXPERT=y here, so the media filter would default off and build every media class (DVB, radio, SDR, test drivers). On,
# with platform devices only: that turns on VIDEO_DEV and MEDIA_CONTROLLER (their prompts are hidden under the filter).
# No ancillary autoselect: it would select I2C_MUX for sensors and tuners this board has not.
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
CONFIG_STAGING=y
CONFIG_STAGING_MEDIA=y
CONFIG_VIDEO_SUNXI=y
CONFIG_VIDEO_SUNXI_CEDRUS=y
# what the lines above give (cedrus selects the last four): no visible prompt of their own, listed to check the result
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_MEDIA_CONTROLLER_REQUEST_API=y
CONFIG_V4L2_MEM2MEM_DEV=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y
# the VE's power domain (power-domains = <&ppu PD_VE> in the device tree)
CONFIG_SUN20I_PPU=y
# CMA, in 4 MiB steps (the page block): the 720x1920 framebuffer (5.3 MiB) and the decoder (4.7 MiB at 800x480, 5.7 at
# 960x540): 2 bitstream buffers of 1 MiB and the NV12 pictures (spike-vdec: max_num_ref_frames + 3, at least 4), each
# picture in its own 1 MiB-aligned slot (CMA aligns a buffer to its size's order, up to 1 MiB). 16 holds 7 pictures at
# either size, 12 only 3; 720p pictures take 2 slots each, 20 holds 5.
# Android Auto at 720p (the phone's UI 960x540 shown 1:1; 480p was scaled up, soft): 16 held its 4 pictures only now
# and then, each 1.38 MB picture taking two 1 MiB slots. 24 held them, but squeezed the rest of the RAM: the session's
# start then reclaimed ~80 MB of page cache (re-read from the NOR) and the phone gave up waiting. So 16, with buffers
# aligned to 64 KiB rather than 1 MiB (nothing here needs more: the VE and the DE take physical addresses, no IOMMU):
# 720p's four pictures then take 5.5 MB, not 8.
CONFIG_CMA_SIZE_MBYTES=16
CONFIG_CMA_ALIGNMENT=4
# Bluetooth: the AIC8800D80's own BT, reached over the SDIO bus it already sits on (no UART, no serdev, no DT change).
# aic8800_fdrv built with CONFIG_SDIO_BT=y registers hci0 itself (btsdio.c): HCI packets ride in the Wi-Fi firmware's
# messages (fmacfwbt_8800d80_h_u02.bin, already in /lib/firmware/aic8800). Add to board/f133/linux.fragment; the aic8800
# package must then be rebuilt (aic8800-dirclean): its modules are built against this kernel.
# BT_BREDR and BT_LE default to y; BT selects CRYPTO_ECDH/CMAC/ECB/SHA256/LIB_AES (LE pairing).
CONFIG_BT=m
# The controller is LE only (LMP features: "BR/EDR not supported"), so no RFCOMM (Android Auto's wireless start, HFP)
# and no BNEP (PAN): those would go through the screen's MCU
# CONFIG_BT_RFCOMM is not set
# CONFIG_BT_BNEP is not set
# on by default with DEBUG_FS; not wanted in 64 MiB
# CONFIG_BT_DEBUGFS is not set
# The SPI NOR (the device tree's partitions, the whole chip as mtd0 as well): spi-sun6i (CONFIG_SPI_SUN6I=y) drives the
# D1's SPI0. The root from it read only (mtdblock), /data on JFFS2, the root squashfs in xz.
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_PARTITIONED_MASTER=y
CONFIG_SPI_MEM=y
CONFIG_MTD_SPI_NOR=y
# CONFIG_MTD_SPI_NOR_USE_4K_SECTORS is not set
CONFIG_MTD_BLOCK_RO=y
CONFIG_JFFS2_FS=y
CONFIG_SQUASHFS_XZ=y
# Trims: the kernel stays resident (text + data were ~12 MB of the 64 MiB) and has to fit the NOR. Nothing here uses
# them: the root is squashfs, the card vfat (so no ext4); no LSMs, cgroups, namespaces, audit, perf, eBPF syscalls,
# io_uring, IPsec, tunnels or traffic control; no EFI (U-Boot's booti); one core. Symbols: System.map, kept beside each
# kernel (no kallsyms).
# CONFIG_EXT4_FS is not set
# CONFIG_SECURITY is not set
# CONFIG_LIBNVDIMM is not set
# CONFIG_IO_URING is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_AUDIT is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_PROFILING is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_IKCONFIG is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_KALLSYMS is not set
# CONFIG_EFI is not set
# CONFIG_SUSPEND is not set
CONFIG_NR_CPUS=2
# CONFIG_INET_DIAG is not set
# CONFIG_IPV6_SIT is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET6_ESP is not set
# CONFIG_XFRM_USER is not set
# CONFIG_NET_KEY is not set
# CONFIG_NET_SCHED is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_DUMMY is not set
# CONFIG_MACVLAN is not set
# CONFIG_IPVLAN is not set
# CONFIG_VXLAN is not set
# CONFIG_VETH is not set
# sysfs and devices nobody here uses (counted on the screen: ~24k kernfs nodes, 3 MB unreclaimable): the
# 256 legacy BSD pty pairs were 512 devices (5,900 sysfs nodes, a kmalloc-1k device each, /dev inodes; Unix98 ptys
# stay); one loop device for the card's rootfs.sqfs (more come from /dev/loop-control); SLUB_DEBUG's per-cache files
# (slub_debug= tries OOM'd this board twice: not used again)
# CONFIG_LEGACY_PTYS is not set
CONFIG_BLK_DEV_LOOP_MIN_COUNT=1
# CONFIG_SLUB_DEBUG is not set
