# The F133's additions to Buildroot's busybox config (BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES)
# NTP (udhcpc's ntp hook): the clock when there is internet; the RTC keeps no time across a power-off
CONFIG_NTPD=y
# the hook's time limit on that try
CONFIG_TIMEOUT=y
# what nor.sh (tools/nor) writes and checks the SPI NOR with
CONFIG_FLASHCP=y
CONFIG_FLASH_ERASEALL=y
CONFIG_SHA256SUM=y
# the DHCP server on Android Auto's AP (dash-aa)
CONFIG_UDHCPD=y
