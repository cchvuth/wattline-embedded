--- a/drivers/mtd/mtdblock_ro.c
+++ b/drivers/mtd/mtdblock_ro.c
@@ -12,13 +12,21 @@
 #include <linux/module.h>
 #include <linux/major.h>
 
+/*
+ * 4 KiB sectors, not 512 bytes: a page of the filesystem above (squashfs) is then one mtd_read, not eight. On an SPI
+ * NOR each read is a transfer of its own (command, address, DMA set up): on the F133 at 24 MHz, 512-byte reads gave
+ * 0.79 MB/s and 4 KiB reads 1.98 MB/s, and cold files read 1.7 to 2.8 times faster through squashfs.
+ */
+#define MTDBLOCK_RO_SHIFT	12
+#define MTDBLOCK_RO_SIZE	(1 << MTDBLOCK_RO_SHIFT)
+
 static int mtdblock_readsect(struct mtd_blktrans_dev *dev,
 			      unsigned long block, char *buf)
 {
 	size_t retlen;
 	int err;
 
-	err = mtd_read(dev->mtd, (block * 512), 512, &retlen, buf);
+	err = mtd_read(dev->mtd, (loff_t)block << MTDBLOCK_RO_SHIFT, MTDBLOCK_RO_SIZE, &retlen, buf);
 	if (err && !mtd_is_bitflip(err))
 		return 1;
 	return 0;
@@ -29,7 +37,7 @@
 {
 	size_t retlen;
 
-	if (mtd_write(dev->mtd, (block * 512), 512, &retlen, buf))
+	if (mtd_write(dev->mtd, (loff_t)block << MTDBLOCK_RO_SHIFT, MTDBLOCK_RO_SIZE, &retlen, buf))
 		return 1;
 	return 0;
 }
@@ -44,7 +52,7 @@
 	dev->mtd = mtd;
 	dev->devnum = mtd->index;
 
-	dev->size = mtd->size >> 9;
+	dev->size = mtd->size >> MTDBLOCK_RO_SHIFT;
 	dev->tr = tr;
 	dev->readonly = 1;
 
@@ -65,7 +73,7 @@
 	.name		= "mtdblock",
 	.major		= MTD_BLOCK_MAJOR,
 	.part_bits	= 0,
-	.blksize 	= 512,
+	.blksize 	= MTDBLOCK_RO_SIZE,
 	.readsect	= mtdblock_readsect,
 	.writesect	= mtdblock_writesect,
 	.add_mtd	= mtdblock_add_mtd,
