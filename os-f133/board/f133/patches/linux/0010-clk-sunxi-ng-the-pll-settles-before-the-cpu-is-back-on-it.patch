--- a/drivers/clk/sunxi-ng/ccu-sun20i-d1.c
+++ b/drivers/clk/sunxi-ng/ccu-sun20i-d1.c
@@ -1332,7 +1332,7 @@
 static struct ccu_mux_nb sun20i_d1_riscv_nb = {
 	.common		= &riscv_clk.common,
 	.cm		= &riscv_clk.mux,
-	.delay_us       = 1,
+	.delay_us       = 20,	/* (1: see ccu_mux_notifier_cb) */
 	.bypass_index   = 4, /* index of pll-periph0 */
 };
 
--- a/drivers/clk/sunxi-ng/ccu_mux.c
+++ b/drivers/clk/sunxi-ng/ccu_mux.c
@@ -293,6 +293,17 @@
 		ret = ccu_mux_helper_set_parent(mux->common, mux->cm,
 						mux->bypass_index);
 	} else if (event == POST_RATE_CHANGE) {
+		/*
+		 * The F133's CPU above its data sheet's clock: the PLL given
+		 * time to settle at its new rate before the CPU is back on it.
+		 * Its lock bit does not say so: it is still up from the rate
+		 * before, and nothing else waits here (the D1 has no notifier
+		 * for the PLL itself, only this one). Measured on that board,
+		 * changing to 1392 MHz by hand: back on the PLL at once hung it
+		 * on the first change, 20 us after the new rate within some 130,
+		 * and 100 us were enough for 600.
+		 */
+		usleep_range(2000, 3000);
 		ret = ccu_mux_helper_set_parent(mux->common, mux->cm,
 						mux->original_index);
 	}
