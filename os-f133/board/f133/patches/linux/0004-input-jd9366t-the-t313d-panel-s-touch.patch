diff -uNr a/drivers/input/touchscreen/jd9366t.c b/drivers/input/touchscreen/jd9366t.c
--- a/drivers/input/touchscreen/jd9366t.c
+++ b/drivers/input/touchscreen/jd9366t.c
@@ -0,0 +1,181 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Jadard JD9366T touch: the touch half of the JD9366T display driver (TDDI), as on the SRNUBI T313D's 720x1920 panel.
+ * I2C (0x68 there), a level-low interrupt. A read is a 6-byte header, the 32-bit address and the 16-bit length both
+ * big-endian, then the data. The touch firmware runs from the chip itself and starts with the display: 0xA55A at
+ * 0x20021000 once it is up, and a table of sections at 0x200210d0 (little-endian address, length pairs) whose second
+ * is the report: the finger count (0xff: not valid), 2 bytes, then ten 5-byte points, X and Y big-endian (0xffff:
+ * unused) and a byte. Coordinates are the panel's own, portrait. As the stock Melis driver reads it
+ * (jd9366t_GetID, jd9366t_ReadSectionInfo and its interrupt task).
+ */
+
+#include <asm/unaligned.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/input/touchscreen.h>
+#include <linux/interrupt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/workqueue.h>
+
+#define JD_ID		0x40008076
+#define JD_ID_9366T	0x9032
+#define JD_READY	0x20021000
+#define JD_SECTIONS	0x200210d0
+#define JD_REPORT	0x20021120	/* the table's second entry on the T313D, if the table cannot be read */
+#define JD_POINTS	10
+#define JD_REPORT_LEN	(3 + JD_POINTS * 5)
+
+struct jd_ts {
+	struct i2c_client *client;
+	struct input_dev *input;
+	struct touchscreen_properties prop;
+	struct delayed_work start;
+	int tries;
+	u32 report;
+};
+
+static int jd_read(struct i2c_client *c, u32 addr, void *buf, u16 len)
+{
+	u8 hdr[6];
+	struct i2c_msg msg[2] = {
+		{ .addr = c->addr, .len = sizeof(hdr), .buf = hdr },
+		{ .addr = c->addr, .flags = I2C_M_RD, .len = len, .buf = buf },
+	};
+	int ret;
+
+	put_unaligned_be32(addr, hdr);
+	put_unaligned_be16(len, hdr + 4);
+	ret = i2c_transfer(c->adapter, msg, 2);
+	return ret == 2 ? 0 : ret < 0 ? ret : -EIO;
+}
+
+static irqreturn_t jd_irq(int irq, void *data)
+{
+	struct jd_ts *ts = data;
+	u8 buf[JD_REPORT_LEN];
+	int i;
+
+	if (jd_read(ts->client, ts->report, buf, sizeof(buf))) {
+		msleep(20);	/* a level interrupt with no answer: not a busy loop */
+		return IRQ_HANDLED;
+	}
+	if (buf[0] == 0xff)
+		return IRQ_HANDLED;
+	for (i = 0; i < JD_POINTS; i++) {
+		const u8 *p = buf + 3 + 5 * i;
+		u16 x = get_unaligned_be16(p), y = get_unaligned_be16(p + 2);
+
+		if (x == 0xffff || y == 0xffff)
+			continue;
+		input_mt_slot(ts->input, i);
+		input_mt_report_slot_state(ts->input, MT_TOOL_FINGER, true);
+		touchscreen_report_pos(ts->input, &ts->prop, x, y, true);
+	}
+	input_mt_sync_frame(ts->input);	/* the points not in this report are lifted */
+	input_sync(ts->input);
+	return IRQ_HANDLED;
+}
+
+/*
+ * Once the touch firmware is up (it starts with the display, a few seconds into the boot), the report's address from
+ * the section table, then the interrupt: before that the line is not the firmware's (it may sit low), and a level
+ * interrupt there would only spin. Looked for every 100 ms, for a minute.
+ */
+static void jd_start(struct work_struct *work)
+{
+	struct jd_ts *ts = container_of(to_delayed_work(work), struct jd_ts, start);
+	struct device *dev = &ts->client->dev;
+	u8 b[2 * 8];
+
+	if (jd_read(ts->client, JD_READY, b, 2) || get_unaligned_le16(b) != 0xa55a) {
+		if (++ts->tries < 600)
+			schedule_delayed_work(&ts->start, msecs_to_jiffies(100));
+		else
+			dev_err(dev, "the touch firmware never came up\n");
+		return;
+	}
+	if (!jd_read(ts->client, JD_SECTIONS, b, sizeof(b)) && get_unaligned_le32(b + 8))
+		ts->report = get_unaligned_le32(b + 8);
+	dev_info(dev, "up after %d ms, the report at %#x\n", ts->tries * 100, ts->report);
+	enable_irq(ts->client->irq);
+}
+
+static void jd_stop(void *data)
+{
+	struct jd_ts *ts = data;
+
+	cancel_delayed_work_sync(&ts->start);
+}
+
+static int jd_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gpio_desc *reset;
+	struct jd_ts *ts;
+	u8 id[2];
+	int ret;
+
+	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
+	if (!ts)
+		return -ENOMEM;
+	ts->client = client;
+	ts->report = JD_REPORT;
+
+	/* the touch's reset (the T313D's PG8, stock ctp_wakeup), held released: its firmware runs with the display's */
+	reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(reset))
+		return dev_err_probe(dev, PTR_ERR(reset), "reset gpio\n");
+
+	if (jd_read(client, JD_ID, id, sizeof(id)))
+		dev_info(dev, "no answer yet\n");
+	else if (get_unaligned_le16(id) != JD_ID_9366T)
+		dev_warn(dev, "IC id %04x, not the JD9366T's %04x\n", get_unaligned_le16(id), JD_ID_9366T);
+
+	ts->input = devm_input_allocate_device(dev);
+	if (!ts->input)
+		return -ENOMEM;
+	ts->input->name = "JD9366T touch";
+	ts->input->id.bustype = BUS_I2C;
+	input_set_abs_params(ts->input, ABS_MT_POSITION_X, 0, 719, 0, 0);
+	input_set_abs_params(ts->input, ABS_MT_POSITION_Y, 0, 1919, 0, 0);
+	touchscreen_parse_properties(ts->input, true, &ts->prop);
+	ret = input_mt_init_slots(ts->input, JD_POINTS, INPUT_MT_DIRECT | INPUT_MT_DROP_UNUSED);
+	if (ret)
+		return ret;
+	ret = input_register_device(ts->input);
+	if (ret)
+		return ret;
+	/* off until the touch firmware is up (jd_start) */
+	ret = devm_request_threaded_irq(dev, client->irq, NULL, jd_irq, IRQF_ONESHOT | IRQF_NO_AUTOEN, "jd9366t", ts);
+	if (ret)
+		return ret;
+	INIT_DELAYED_WORK(&ts->start, jd_start);
+	ret = devm_add_action_or_reset(dev, jd_stop, ts);
+	if (ret)
+		return ret;
+	schedule_delayed_work(&ts->start, 0);
+	return 0;
+}
+
+static const struct of_device_id jd_of_match[] = {
+	{ .compatible = "jadard,jd9366t" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, jd_of_match);
+
+static struct i2c_driver jd_driver = {
+	.driver = {
+		.name = "jd9366t",
+		.of_match_table = jd_of_match,
+		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
+	},
+	.probe = jd_probe,
+};
+module_i2c_driver(jd_driver);
+
+MODULE_DESCRIPTION("Jadard JD9366T touch");
+MODULE_LICENSE("GPL");
