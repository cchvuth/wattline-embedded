@@ -1053,6 +1053,16 @@
 	struct drm_device *drm = data;
 	struct sun6i_dsi *dsi = dev_get_drvdata(dev);
 	int ret;
+
+	/* tcon-top is bound before us in the pipeline, so its DSI gate clock exists now */
+	if (dsi->variant->has_mod_clk && !dsi->mod_clk) {
