+/*
+ * The 16 MiB SPI NOR (XMC XM25QH128C, JEDEC 20 40 18) on SPI0, PC2..PC5 (clock, CS, MOSI, MISO; stock sys_config
+ * [spinor_para]). Its WP# and HOLD# (PC6, PC7) are driven high as GPIOs at every start, whatever boots: the flash
+ * ignores its clock while HOLD# is low, and Linux's spi0 takes only PC2..PC5. The reads are the probe's (src/main.rs,
+ * which copied the flash with them): CS by software, 64-byte FIFO bursts the CPU fills and empties. The D1's SPI has
+ * no clock divider (Linux spi-sun6i: the R329 variant), so the module clock is the SPI clock.
+ */
+#define F133_SPI(o)		F133_REG(0x04025000 + (o))
+#define F133_SPI_GCR		F133_SPI(0x04)
+#define F133_SPI_TCR		F133_SPI(0x08)
+#define F133_SPI_IER		F133_SPI(0x10)
+#define F133_SPI_ISR		F133_SPI(0x14)
+#define F133_SPI_FCR		F133_SPI(0x18)
+#define F133_SPI_FSR		F133_SPI(0x1c)
+#define F133_SPI_MBC		F133_SPI(0x30)
+#define F133_SPI_MTC		F133_SPI(0x34)
+#define F133_SPI_BCC		F133_SPI(0x38)
+#define F133_SPI_TXD		F133_SPI(0x200)
+#define F133_SPI_RXD		F133_SPI(0x300)
+#define F133_PC_CFG0		F133_REG(0x02000060)
+#define F133_PC_DAT		F133_REG(0x02000070)
+
+static void f133_nor_pins(void)
+{
+	setbits_le32(F133_PC_DAT, BIT(6) | BIT(7));
+	clrsetbits_le32(F133_PC_CFG0, 0xff << 24, 0x11 << 24);		/* PC6, PC7: outputs, high */
+}
+
+/*
+ * SPI0 for the NOR at about mhz: 24 (the crystal: the probe's clock), or 40..100 from PLL_PERI(1x), 600 MHz / M (M up
+ * to 16); anything else is 24. Returns the clock it runs at, in MHz.
+ */
+static uint f133_nor_init(uint mhz)
+{
+	u32 c = readl(F133_PC_CFG0), m = mhz > 24 ? DIV_ROUND_UP(600, mhz) : 0;
+	int pin;
+
+	if (m > 16)
+		m = 0;
+	mhz = m ? 600 / m : 24;
+	for (pin = 2; pin < 6; pin++)
+		c = (c & ~(0xf << (pin * 4))) | (2 << (pin * 4));	/* PC2..PC5: SPI0 */
+	writel(c, F133_PC_CFG0);
+	f133_nor_pins();
+	setbits_le32(F133_REG(0x0200196c), BIT(16));			/* SPI0 out of reset */
+	setbits_le32(F133_REG(0x0200196c), BIT(0));			/* and clocked */
+	if (m)
+		writel(BIT(31) | (1 << 24) | (m - 1), F133_REG(0x02001940));
+	else
+		writel(BIT(31), F133_REG(0x02001940));			/* the 24 MHz crystal */
+	writel(BIT(31), F133_SPI_GCR);					/* soft reset */
+	F133_WAIT(!(readl(F133_SPI_GCR) & BIT(31)));
+	writel(BIT(7) | BIT(1) | BIT(0), F133_SPI_GCR);			/* transmit pause, master, on */
+	/* CS high, by software; sampling as spi-sun6i: normal to 24 MHz, half a clock late to 80, a clock above */
+	writel((mhz <= 24 ? BIT(13) : 0) | (mhz >= 80 ? BIT(11) : 0) | BIT(7) | BIT(6), F133_SPI_TCR);
+	writel(0, F133_SPI_IER);
+	return mhz;
+}
+
+static void f133_nor_cs(bool low)
+{
+	if (low)
+		clrbits_le32(F133_SPI_TCR, BIT(7));
+	else
+		setbits_le32(F133_SPI_TCR, BIT(7));
+}
+
+/* n (<= 64) bytes out of tx (zeros if NULL) and in to rx (dropped if NULL; may be tx); false on a timeout */
+static bool f133_nor_xfer(const u8 *tx, u8 *rx, int n)
+{
+	int i;
+
+	writel(BIT(31) | BIT(15), F133_SPI_FCR);			/* both FIFOs reset */
+	writel(~0, F133_SPI_ISR);
+	writel(n, F133_SPI_MBC);
+	writel(n, F133_SPI_MTC);
+	writel(n, F133_SPI_BCC);
+	for (i = 0; i < n; i++)
+		writeb(tx ? tx[i] : 0, F133_SPI_TXD);
+	setbits_le32(F133_SPI_TCR, BIT(31));				/* exchange */
+	if (!F133_WAIT((readl(F133_SPI_FSR) & 0xff) >= n))
+		return false;
+	for (i = 0; i < n; i++) {
+		u8 b = readb(F133_SPI_RXD);
+
+		if (rx)
+			rx[i] = b;
+	}
+	return F133_WAIT(!(readl(F133_SPI_TCR) & BIT(31)));
+}
+
+/* op, then n (1..3) bytes back, big-endian; ~0 on a timeout */
+static u32 f133_nor_reg(u8 op, int n)
+{
+	u8 b[4] = { op };
+	u32 v = 0;
+	bool ok;
+	int i;
+
+	f133_nor_cs(true);
+	ok = f133_nor_xfer(b, b, n + 1);
+	f133_nor_cs(false);
+	for (i = 1; i <= n; i++)
+		v = v << 8 | b[i];
+	return ok ? v : ~0;
+}
+
+/*
+ * n (<= 64 KiB) bytes in to p in one burst, on both data lines if dual. The controller stops its clock while the
+ * FIFO is full (the transmit pause set at init), so the CPU only has to empty it; false on a timeout.
+ */
+static bool f133_nor_rx(u8 *p, u32 n, bool dual)
+{
+	ulong t = get_timer(0);
+	u32 c, idle = 0;
+
+	writel(BIT(31) | BIT(15), F133_SPI_FCR);			/* both FIFOs reset */
+	writel(~0, F133_SPI_ISR);
+	writel(n, F133_SPI_MBC);
+	writel(0, F133_SPI_MTC);
+	writel(dual ? BIT(28) : 0, F133_SPI_BCC);
+	setbits_le32(F133_SPI_TCR, BIT(31));				/* exchange */
+	while (n) {
+		c = min_t(u32, readl(F133_SPI_FSR) & 0xff, n);
+		if (!c) {
+			if (!(++idle & 0xfff) && get_timer(t) > 250)	/* (the timer is a call to OpenSBI: seldom) */
+				return false;
+			continue;
+		}
+		for (n -= c; c; c--)
+			*p++ = readb(F133_SPI_RXD);
+	}
+	return F133_WAIT(!(readl(F133_SPI_TCR) & BIT(31)));
+}
+
+/*
+ * len bytes from off (3-byte addresses: the whole 16 MiB) into dst; false on a timeout. To 24 MHz: READ, in 64-byte
+ * exchanges, as the probe (the SPL's way to U-Boot, and the second try at the kernel: left as proven). Above: the
+ * dual output FAST READ (a dummy byte after the address, the data on both lines) in bursts of 64 KiB the CPU only
+ * empties: the exchanges gave 2 MB/s whatever the clock (the kernel's FIT took 2.1 s of each start).
+ */
+static bool f133_nor_read(void *dst, u32 off, u32 len, uint mhz)
+{
+	bool fast = mhz > 24;
+	u8 cmd[5] = { fast ? 0x3b : 0x03, off >> 16, off >> 8, off, 0 };
+	u8 *p = dst;
+	u32 n, i;
+	bool ok;
+
+	f133_nor_cs(true);
+	ok = f133_nor_xfer(cmd, NULL, fast ? 5 : 4);
+	for (i = 1; ok && len; len -= n, p += n, i++) {
+		n = min_t(u32, len, fast ? SZ_64K : 64);
+		ok = fast ? f133_nor_rx(p, n, true) : f133_nor_xfer(NULL, p, n);
+		if (fast || !(i % 1024))
+			schedule();					/* each 64 KiB: the watchdog */
+	}
+	f133_nor_cs(false);
+	return ok;
+}
+
+#ifdef CONFIG_SPL_BUILD
+static uint f133_spl_mhz = 24;
+
+static ulong f133_spl_nor_read(struct spl_load_info *load, ulong off, ulong count, void *buf)
+{
+	return f133_nor_read(buf, off, count, f133_spl_mhz) ? count : 0;
+}
+
+/*
+ * The BROM booted the SPL from the NOR: U-Boot's FIT (OpenSBI, U-Boot proper, its device tree) follows it there, as in
+ * u-boot-sunxi-with-spl.bin (binman: right after the SPL, 32 KiB in at least). At 50 MHz, as U-Boot reads the kernel
+ * (0.07 s where the probe's 24 MHz READ took 0.45 of each start); that READ again if the FIT does not load so.
+ */
+static int f133_spl_nor_load(struct spl_image_info *spl_image, struct spl_boot_device *bootdev)
+{
+	struct legacy_img_hdr *header = (struct legacy_img_hdr *)CONFIG_TEXT_BASE;
+	struct spl_load_info load = { .bl_len = 1, .read = f133_spl_nor_read };
+	u32 off = max_t(u32, sunxi_get_spl_size(), 0x8000);
+	int try;
+
+	for (try = 0; try < 2; try++) {
+		f133_spl_mhz = f133_nor_init(try ? 24 : 50);
+		printf("F133: NOR JEDEC %06x, status %02x; U-Boot's FIT at 0x%x, %u MHz, at %lu ms\n", f133_nor_reg(0x9f, 3),
+		       f133_nor_reg(0x05, 1), off, f133_spl_mhz, get_timer(0));
+		if (f133_nor_read(header, off, 64, f133_spl_mhz) && image_get_magic(header) == FDT_MAGIC &&
+		    !spl_load_simple_fit(spl_image, &load, off, header))
+			return 0;
+	}
+	return -EINVAL;
+}
+SPL_LOAD_IMAGE_METHOD("F133 SPI NOR", 0, BOOT_DEVICE_SPI, f133_spl_nor_load);
+#else
+/*
+ * U-Boot proper: "f133nor id" puts the JEDEC id and status registers 1, 2 in nor_id, nor_sr; "f133nor <addr> <offset>
+ * <len>" reads (hex), its time in ms into nor_ms, the clock it ran at into nor_mhz. The SPI clock: env norclk (MHz;
+ * 24, or 40..100), 24 if unset.
+ */
+static int do_f133nor(struct cmd_tbl *cmdtp, int flag, int argc, char *const argv[])
+{
+	uint mhz = f133_nor_init(env_get_ulong("norclk", 10, 24));
+	ulong addr, off, len, t;
+	char v[16];
+
+	if (argc == 2 && !strcmp(argv[1], "id")) {
+		snprintf(v, sizeof(v), "%06x", f133_nor_reg(0x9f, 3));
+		env_set("nor_id", v);
+		snprintf(v, sizeof(v), "%02x%02x", f133_nor_reg(0x05, 1), f133_nor_reg(0x35, 1));
+		env_set("nor_sr", v);
+		printf("NOR: JEDEC %s, status %s\n", env_get("nor_id"), v);
+		return CMD_RET_SUCCESS;
 	}
+	if (argc != 4)
+		return CMD_RET_USAGE;
+	addr = hextoul(argv[1], NULL);
+	off = hextoul(argv[2], NULL);
+	len = hextoul(argv[3], NULL);
+	if (off + len > SZ_16M)
+		return CMD_RET_FAILURE;
+	t = get_timer(0);
+	if (!f133_nor_read(map_sysmem(addr, len), off, len, mhz)) {
+		puts("NOR: SPI timeout\n");
+		return CMD_RET_FAILURE;
+	}
+	env_set_ulong("nor_ms", get_timer(t));
+	env_set_ulong("nor_mhz", mhz), env_set_ulong("nor_t", get_timer(0));
+	return CMD_RET_SUCCESS;
 }
+
+U_BOOT_CMD(f133nor, 4, 0, do_f133nor, "SRNUBI T313D: read the SPI NOR",
+	   "id - JEDEC id, status registers 1 and 2 into nor_id, nor_sr\n"
+	   "f133nor <addr> <offset> <len> - read (hex values), the ms it took into nor_ms, the MHz into nor_mhz\n"
+	   "env norclk: the SPI clock in MHz (24, or 40..100), 24 if unset");
+#endif
 
