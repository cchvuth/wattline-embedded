+void spl_board_prepare_for_boot(void)
+{
+	void __iomem *w = F133_REG(0x06011000);
+
+	writel((readl(w + 0x14) & ~0x3) | 0x1 | 0x16aa0000, w + 0x14);			/* CFG: reset the system */
+	writel((readl(w + 0x18) & ~(0xf << 4)) | (0xb << 4) | 0x16aa0000, w + 0x18);	/* MODE: 16 s */
+	writel(readl(w + 0x18) | BIT(0) | 0x16aa0000, w + 0x18);			/* on */
+	writel((0xa57 << 1) | 1, w + 0x10);						/* CTRL: restart */
+	printf("F133: watchdog %08x %08x; on to OpenSBI and U-Boot proper at %lu ms\n", readl(w + 0x14),
+	       readl(w + 0x18), get_timer(0));
+	f133_log_save();
+}
