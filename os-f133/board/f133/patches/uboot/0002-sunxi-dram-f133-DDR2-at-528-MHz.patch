+/*
+ * SRNUBI T313D (F133): this C port of libdram fails the DQS gate training here (DXGSR0 0x13000000 on both lanes, rank
+ * 0 included). Tried first: what `xfel ddr f133` does, which works on the F133: xfel's clock set-up, then Allwinner's
+ * own libdram V0.24 (mctl_hal_f133.S, SPL only) with the stock sys_config [dram_para].
+ */
+#ifdef CONFIG_SPL_BUILD
+int aw_init_DRAM(int type, void *para);
+
+void sdelay(unsigned long us)
+{
+	udelay(us);
+}
+
+int sys_uart_printf(const char *fmt, ...)
+{
+	va_list va;
+
+	va_start(va, fmt);
+	vprintf(fmt, va);
+	va_end(va);
+	return 0;
+}
+
+/* xfel's f133-ddr sys_clock_init() steps the SPL leaves out: AHB, APB0, DMA, the MBUS reset and master gates */
+static void f133_xfel_clocks(void)
+{
+	writel((2 << 0) | (0 << 8), SUNXI_CCM_BASE + 0x510);		/* PSI/AHB: M 3 (from the crystal) */
+	setbits_le32(SUNXI_CCM_BASE + 0x510, 0x3 << 24);		/* then PLL_PERI(1x): 200 MHz */
+	udelay(1);
+	writel((2 << 0) | (1 << 8), SUNXI_CCM_BASE + 0x520);		/* APB0: M 3, N 2 */
+	setbits_le32(SUNXI_CCM_BASE + 0x520, 0x3 << 24);		/* from PLL_PERI(1x): 100 MHz */
+	udelay(1);
+	setbits_le32(SUNXI_CCM_BASE + 0x70c, BIT(16));		/* DMA out of reset */
+	udelay(20);
+	setbits_le32(SUNXI_CCM_BASE + 0x70c, BIT(0));			/* and clocked */
+	setbits_le32(SUNXI_CCM_BASE + 0x540, BIT(30));		/* MBUS out of reset */
+	udelay(1);
+	writel(0x00000d87, SUNXI_CCM_BASE + 0x804);			/* MBUS master clock gates */
+}
+#endif
+
 unsigned long sunxi_dram_init(void)
 {
-	return init_DRAM(0, &para) * 1024UL * 1024;
+#ifdef CONFIG_SPL_BUILD
+	/*
+	 * The stock sys_config [dram_para] (= xfel's f133 ddr_param), but its clock: 696 MHz, not 528 (a memory copy
+	 * 37 % faster; a scrolled frame of the dash 14 ms where it took 18). On this board a pattern test ran ten
+	 * minutes without a wrong word at 696, and at 720 the board did not start. The 528 again if the memory does
+	 * not come up at 696, and from the third start since the power came on (two resets in a row: the SPL's count
+	 * of its starts, the RTC's register 6). libdram writes what it finds back into p.
+	 */
+	static const u32 stock[32] = {
+		528, 2, 0x007b7bf9, 0, 0x000000d2, 0, 0x00000e73, 0x02, 0, 0,
+		0x00471992, 0x0131a10c, 0x00057041, 0xb4787896, 0, 0x48484848, 0x00000048, 0x1621121e,
+		0, 0, 0, 0x00030010, 0x00000035, 0x34000000,
+	};
+	u32 p[32], clk = readl(0x07090118) >= 3 ? 528 : 696;
+	unsigned long mb;
+
+	memcpy(p, stock, sizeof(p));
+	p[0] = clk;
+
+	printf("F133: PSI %08x APB0 %08x DMA_BGR %08x MBUS %08x MBUS_GATES %08x before xfel's clocks\n",
+	       readl(SUNXI_CCM_BASE + 0x510), readl(SUNXI_CCM_BASE + 0x520), readl(SUNXI_CCM_BASE + 0x70c),
+	       readl(SUNXI_CCM_BASE + 0x540), readl(SUNXI_CCM_BASE + 0x804));
+	f133_xfel_clocks();
+	csr_set(CSR_MSTATUS, SR_FS);		/* libdram uses the FPU */
+	csr_set(0x7c0, BIT(22));		/* MXSTATUS.THEADISAEE: and the T-Head instructions */
+	printf("F133: libdram at %lu ms\n", get_timer(0));
+	mb = aw_init_DRAM(0, p);
+	printf("F133: libdram: %lu MiB at %lu ms, para1 %08x para2 %08x tpr13 %08x\n", mb, get_timer(0), p[4], p[5],
+	       p[23]);
+	if (!mb && clk != 528) {
+		printf("F133: no DRAM at %u MHz: at 528\n", clk);
+		memcpy(p, stock, sizeof(p));
+		mb = aw_init_DRAM(0, p);
+		printf("F133: libdram: %lu MiB at %lu ms\n", mb, get_timer(0));
+	}
+	if (!mb) {
+		f133_log_save();
+		/* the C port as well, after the same clocks (its scan fails fast; its fixed layout hung on DRAM) */
+		printf("F133: C driver at %lu ms\n", get_timer(0));
+		mb = init_DRAM(0, &para);
+	}
+#else
+	unsigned long mb = init_DRAM(0, &para);
+#endif
+	printf("F133: DRAM %lu MiB\n", mb);
+
+	return mb * 1024UL * 1024;
 };
 
