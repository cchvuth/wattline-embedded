#!/bin/sh
# R3: the card's partitions, found by device type (SD), never by name. p3 (ext4, writable, made once by dash-mkdata) on
# /data after fsck -p; p2 (DASHDATA, FAT: dash.conf, ssh/) read-only on /run/dashdata. No p3, or one fsck
# cannot fix: /data stays in RAM (lost at power-off) and everything still runs.
case "$1" in start|"") ;; *) exit 0;; esac
i=0; until grep -qx SD /sys/block/mmcblk[0-9]/device/type 2>/dev/null || [ $i -ge 10 ]; do sleep 1; i=$((i+1)); done
D=; for d in /sys/block/mmcblk[0-9]; do [ "$(cat $d/device/type 2>/dev/null)" = SD ] && D=/dev/${d##*/}; done
mkdir -p /data /run/dashdata
# First boot of a freshly-burned card: carve the writable /data partition (p3) from the free space after p2, so settings
# and the AA cert persist. dash-mkdata self-validates and refuses on any anomaly; it no-ops once p3 exists (owner's card).
if [ -n "$D" ] && [ ! -b ${D}p3 ]; then
	dash-mkdata && { blockdev --rereadpt $D 2>/dev/null; i=0; until [ -b ${D}p3 ] || [ $i -ge 5 ]; do sleep 1; i=$((i+1)); done; }
fi
if [ -n "$D" ] && [ -b ${D}p3 ]; then
	# no ext4 magic where it goes (read, but not 0xEF53): the first boot's carve cut short (power gone during mkfs), or
	# p3 not seen until a reboot. Made now, unless e2fsck finds a filesystem by a backup superblock. Unreadable: left be.
	m=$(dd if=${D}p3 bs=2 skip=540 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')
	if [ ${#m} = 4 ] && [ "$m" != 53ef ] && { e2fsck -fy ${D}p3 >/dev/null 2>&1; [ $? -ge 4 ]; }; then
		mkfs.ext4 -F -q -L DASHDATA2 ${D}p3 </dev/null && echo "data: ${D}p3 had no filesystem: made one"
	fi
	fsck.ext4 -p ${D}p3; r=$?   # 0 clean, 1/2 fixed, 4+ not fixed by preen: then answered yes (as dash-mkdata does),
	[ $r -ge 4 ] && { e2fsck -fy ${D}p3 </dev/null; r=$?; }   # else /data would stay in RAM at every start for good
	if [ $r -lt 4 ] && mount -t ext4 -o noatime ${D}p3 /data; then echo "data: ${D}p3 on /data (fsck $r)"
	else echo "data: ${D}p3 not mounted (fsck $r): /data in RAM"; fi
else
	echo "data: no p3: /data in RAM"
fi
mkdir -p /data/log
[ -n "$D" ] && [ -b ${D}p2 ] && mount -t vfat -o ro ${D}p2 /run/dashdata && echo "dashdata: ${D}p2 on /run/dashdata (ro)"
exit 0
