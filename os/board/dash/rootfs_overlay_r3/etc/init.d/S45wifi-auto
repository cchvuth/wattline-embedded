#!/bin/sh
# R3 WiFi at boot, station only, whichever network is in range (the first listed wins when several are): the networks
# the dash's settings saved in /data/wifi/networks.conf (the car's adapter among them, editable there), with the
# Commander's S3XY_OBD and its factory passphrase first unless that list holds it or it was deleted (car-removed).
# That list is the one source of networks (the settings' Network tab edits it): two lines per network, SSID then
# passphrase (empty: open). It is the owner's: read only, nothing from it is printed or copied.
case "$1" in start|"") ;; *) exit 0;; esac
# Android Auto holds the radio for its AP (dash-aa, /run/dash-aa-radio): a saved list is applied when it stops (a restarted
# wpa_supplicant would rejoin the station beside the AP and drop the projection)
# the network to join, if one was picked; a later save without one keeps it (the pick stands until AA stops)
[ -e /run/dash-aa-radio ] && { if [ -n "$2" ] || [ ! -e /run/wifi-auto.pending ]; then printf '%s\n' "$2" > /run/wifi-auto.pending; fi; exit 0; }
JOIN=$2   # start SSID: join that network now (the settings' Connect): it goes first, the rest stay as fallback
(
	# one at a time: two quick saves in the settings must not race (the later list wins, as saved)
	i=0; got=; until mkdir /run/wifi-auto.lock 2>/dev/null && got=1; do [ $i -ge 30 ] && break; sleep 1; i=$((i+1)); done
	[ -n "$got" ] && trap 'rmdir /run/wifi-auto.lock 2>/dev/null' EXIT   # only a lock this run took is freed by it
	[ -e /run/dash-aa-radio ] && { if [ -n "$JOIN" ] || [ ! -e /run/wifi-auto.pending ]; then printf '%s\n' "$JOIN" > /run/wifi-auto.pending; fi; exit 0; }   # AA came up meanwhile
	for i in $(seq 1 20); do [ -e /sys/class/net/wlan0 ] && break; sleep 1; done
	[ -e /sys/class/net/wlan0 ] || exit 0
	set --   # the car's default unless the saved list has it or it was deleted there on purpose (settings.c, the same rule)
	C=/data/wifi/networks.conf
	# SSID lines only (a passphrase may read S3XY_OBD), and a full list (4, the settings' limit) left as it is
	if [ ! -f $C ] || { ! tr -d '\r' < $C | awk 'NR % 2 == 1' | grep -qx S3XY_OBD && [ ! -e /data/wifi/car-removed ] &&
		[ $(tr -d '\r' < $C | awk 'NR % 2 == 1 && $0 != ""' | wc -l) -lt 4 ]; }; then
		set -- S3XY_OBD 12345678
	fi
	for f in /data/wifi/networks.conf; do
		[ -f $f ] || continue
		while IFS= read -r S || [ -n "$S" ]; do
			K=; IFS= read -r K
			S=$(printf %s "$S" | tr -d '\r'); K=$(printf %s "$K" | tr -d '\r')
			[ -n "$S" ] && set -- "$@" "$S" "$K"
		done < $f
	done
	if [ -n "$JOIN" ]; then   # rotate the SSID/passphrase pairs once, holding the chosen one back, then put it first
		n=$(($# / 2)); i=0; JS=; JK=; found=
		while [ $i -lt $n ]; do
			S=$1; K=$2; shift 2
			if [ -z "$found" ] && [ "$S" = "$JOIN" ]; then JS=$S; JK=$K; found=1; else set -- "$@" "$S" "$K"; fi
			i=$((i+1))
		done
		[ -n "$found" ] && set -- "$JS" "$JK" "$@"
	fi
	# the pairs on wifi-connect's stdin, never in its arguments (ps shows those); printf is the shell's own: no process
	while [ $# -gt 1 ]; do printf '%s\n%s\n' "$1" "$2"; shift 2; done | wifi-connect - > /run/wifi-auto.log 2>&1
) &
exit 0
