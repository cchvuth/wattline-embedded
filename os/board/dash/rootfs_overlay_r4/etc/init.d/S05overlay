#!/bin/sh
# The root filesystem is an initramfs: it runs from RAM and is read back from the card at every boot, so a file
# changed on a running Dash is gone after a power cycle. /data/overlay/root is the fix for that: whatever is put
# there (same paths as on /) is copied over the root at boot, right after /data is mounted (S05data) and before
# anything else starts. dash-push.sh writes a file to both places, so a pushed fix is live now and stays.
# An overlay belongs to the image it was made on (/data/overlay/image-id = /etc/image-id): on any other image
# (a newer one burned or updated over the air, or an update slot rolled back) it is skipped, never applied to the
# wrong firmware, and kept, so it is there again when its own image boots.
# Each image's overlay is kept apart: another image's is set aside in $O/saved/<its image-id>, and this image's own
# comes back from there (swap: the same, without applying; dash-push.sh runs it before it adds a file).
case "$1" in start|""|swap) ;; *) exit 0;; esac
O=/data/overlay
ID=$(cat /etc/image-id 2>/dev/null)
[ -n "$ID" ] || exit 0
if [ -d $O/root ] && [ "$(cat $O/image-id 2>/dev/null)" != "$ID" ]; then
	o=$(cat $O/image-id 2>/dev/null | tr -cd '0-9A-Za-z._-'); o=${o:-unknown}
	rm -rf "$O/saved/$o" && mkdir -p "$O/saved/$o" && mv $O/root "$O/saved/$o/" && mv $O/image-id "$O/saved/$o/" 2>/dev/null
	echo "S05overlay: the overlay of image $o set aside"
fi
if [ ! -d $O/root ] && [ -d "$O/saved/$ID/root" ]; then
	mv "$O/saved/$ID/root" $O/ && mv "$O/saved/$ID/image-id" $O/ 2>/dev/null; rm -rf "$O/saved/$ID"
	echo "S05overlay: this image's overlay brought back"
fi
ls -dt $O/saved/*/ 2>/dev/null | tail -n +4 | while read -r d; do rm -rf "$d"; done   # the three newest kept (after the restore)
[ "$1" = swap ] && exit 0
[ -d $O/root ] && [ "$(cat $O/image-id 2>/dev/null)" = "$ID" ] || exit 0
cp -a $O/root/. / && echo "S05overlay: $(find $O/root -type f | wc -l) file(s) applied"
exit 0
