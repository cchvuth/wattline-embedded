#!/bin/sh
# OTA, after the dash is up: once the same dash process has run for 30 s and marked itself ready (looked at from 15 s to
# ~2 min), confirm this start (keeps a new version, which U-Boot would otherwise roll back after 3 unconfirmed starts).
# Then, if automatic updates are on (ota_auto in /data/settings.conf, the dash's Advanced settings), look for a newer
# release while there is internet: download, verify and arm it for the next power-up. Tried every 10 min for the first
# hour of a drive, quietly.
case "$1" in start|"") ;; *) exit 0;; esac
# the same dash for 30 s: a restart is a new pid (a count of the supervisor's start lines missed restarts once dash.out
# rotated, and one 15 s window let a dash crashing every 20 s through), and ready: its display opened in good time
# (/run/dash-ready names it; a display that hangs keeps the dash running, its watchdog not armed yet)
healthy() { p=$(pidof dash) || { sleep 15; return 1; }; sleep 30; [ "$(pidof dash)" = "$p" ] && [ "$(cat /run/dash-ready 2>/dev/null)" = "$p" ]; }
(
	sleep 15
	# looked at for up to 2 min (a dash that crashed once at the start may settle), before S00trial's 4 min
	for t in 1 2 3 4; do
		healthy || continue
		for i in 1 2 3 4 5 6; do   # until it says so: a Check the user tapped may hold the lock, a write may fail once
			dash-update confirm && break
			sleep 10
		done
		break
	done
	grep -qE '^ota_auto *= *1' /data/settings.conf 2>/dev/null || exit 0
	for i in 1 2 3 4 5 6; do
		dash-update auto && exit 0
		grep -qE "^state=(armed|current|ready)$" /run/dash-update.status 2>/dev/null && exit 0
		sleep 600
	done
) </dev/null >/dev/null 2>&1 &
exit 0
