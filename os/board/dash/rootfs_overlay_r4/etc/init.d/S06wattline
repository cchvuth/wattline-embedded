#!/bin/sh
# Keep the Android Auto head-unit certificate (and the Bluetooth bonds, below) on /data (persistent across reboot and reflash). /etc/wattline -> there,
# so the app, aa and dash-aa (all reading /etc/wattline) use the persistent copy with no code change. None is shipped or
# made here: the owner supplies a Google-signed one (/data/wattline/aa.crt + aa.key), and the dash's AA button shows only
# with it. One that cannot work (self-signed, as an earlier version's placeholder, or without its matching key) is moved
# aside as *.unusable, so no button.
case "$1" in start|"") ;; *) exit 0;; esac
mkdir -p /data/wattline
[ -L /etc/wattline ] || { rm -rf /etc/wattline; ln -s /data/wattline /etc/wattline; }
if [ -f /data/wattline/aa.crt ] && ! /usr/bin/aa certcheck /data/wattline/aa.crt /data/wattline/aa.key 2>/dev/null; then
	mv /data/wattline/aa.crt /data/wattline/aa.crt.unusable; mv /data/wattline/aa.key /data/wattline/aa.key.unusable 2>/dev/null
	echo "S06wattline: aa.crt is self-signed or its key is missing / another's: set aside as *.unusable (no AA button)"
fi
# Bluetooth bonds (the phones paired for Android Auto, their keys) on /data too, before bluetoothd starts (S40): in the
# RAM root every power cycle forgot them, and a phone with an old key is then refused (aa takes bonded phones only)
mkdir -p /data/bluetooth && chmod 700 /data/bluetooth
[ -L /var/lib/bluetooth ] || { rm -rf /var/lib/bluetooth; ln -s /data/bluetooth /var/lib/bluetooth; }
exit 0
