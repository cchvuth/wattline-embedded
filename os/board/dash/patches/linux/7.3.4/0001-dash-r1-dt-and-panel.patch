diff -ruN a/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r0.dts b/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r0.dts
--- a/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r0.dts	1970-01-01 01:00:00
+++ b/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r0.dts	2026-11-13 13:00:43
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+// R0: the rescue image's device tree for the S3XY Dash (T113-S4). Console, SD card, eMMC; nothing else.
+// The console UART4 node carries no pinctrl on purpose: the SPL muxes the pins (KCFLAGS -DDASH_U4=n,
+// board/dash/patches/uboot), and U-Boot proper and Linux keep them as set. Typed from the survey, not copied.
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include "sun8i-t113s.dtsi"
+
+/ {
+	model = "S3XY Dash R0";
+	compatible = "dash,s3xy-dash-r0", "allwinner,sun8i-t113s";
+
+	aliases {
+		serial0 = &uart4;
+		mmc0 = &mmc0;	/* microSD (SMHC0, PF0-PF5) */
+		mmc1 = &mmc2;	/* eMMC (SMHC2, PC2-PC7, 4-bit) */
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	reg_3v3: regulator-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+};
+
+&dcxo {
+	clock-frequency = <24000000>;
+};
+
+&uart4 {
+	status = "okay";
+};
+
+&mmc0 {
+	pinctrl-0 = <&mmc0_pins>;
+	pinctrl-names = "default";
+	vmmc-supply = <&reg_3v3>;
+	broken-cd;		/* card-detect pin not known yet: poll */
+	disable-wp;
+	bus-width = <4>;
+	status = "okay";
+};
+
+&mmc2 {
+	pinctrl-0 = <&mmc2_pins>;
+	pinctrl-names = "default";
+	vmmc-supply = <&reg_3v3>;
+	non-removable;
+	bus-width = <4>;
+	status = "okay";
+};
diff -ruN a/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r1.dts b/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r1.dts
--- a/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r1.dts	1970-01-01 01:00:00
+++ b/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r1.dts	2026-11-13 13:00:43
@@ -0,0 +1,177 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+// R1: R0 plus the display (MIPI-DSI panel, backlight), touch and the USB gadget, for the S3XY Dash (T113-S4).
+// Display numbers come from the running stock unit (survey display-facts.md); typed by hand. Radios stay off.
+// The console UART4 node carries no pinctrl on purpose: the SPL muxes the pins (KCFLAGS -DDASH_U4=n,
+// board/dash/patches/uboot), and U-Boot proper and Linux keep them as set. Typed from the survey, not copied.
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/pwm/pwm.h>
+#include "sun8i-t113s.dtsi"
+
+/ {
+	model = "S3XY Dash R1";
+	compatible = "dash,s3xy-dash-r1", "allwinner,sun8i-t113s";
+
+	aliases {
+		serial0 = &uart4;
+		mmc0 = &mmc0;	/* microSD (SMHC0, PF0-PF5) */
+		mmc1 = &mmc2;	/* eMMC (SMHC2, PC2-PC7, 4-bit) */
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	reg_3v3: regulator-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+
+	reg_lcd: regulator-lcd {		/* stock lcd_power_en: PG11, high = on */
+		compatible = "regulator-fixed";
+		regulator-name = "lcd-power";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&pio 6 11 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <20000>;
+	};
+
+	backlight: backlight {			/* stock: lcd_bl_en PG10, PWM7 on PD22 at 50 kHz, active low */
+		compatible = "pwm-backlight";
+		pwms = <&pwm 7 20000 PWM_POLARITY_INVERTED>;
+		enable-gpios = <&pio 6 10 GPIO_ACTIVE_HIGH>;
+		brightness-levels = <0 100>;	/* 0..100 = percent duty */
+		num-interpolated-steps = <100>;
+		default-brightness-level = <30>;	/* from the panel coming up (~2 s) until the dash sets its own */
+	};
+
+	soc {
+		/* T113/D1 PWM (8 channels); the 7.3.4 dtsi has no node yet. As in the mainline submission (v13 3/3). */
+		pwm: pwm@2000c00 {
+			compatible = "allwinner,sun20i-d1-pwm";
+			reg = <0x02000c00 0x400>;
+			clocks = <&ccu CLK_BUS_PWM>, <&dcxo>, <&ccu CLK_APB0>;
+			clock-names = "bus", "hosc", "apb";
+			resets = <&ccu RST_BUS_PWM>;
+			pinctrl-0 = <&pwm7_pd22_pin>;
+			pinctrl-names = "default";
+			#pwm-cells = <3>;
+			allwinner,npwms = <8>;
+		};
+	};
+};
+
+&de {
+	status = "okay";
+};
+
+&dsi {
+	pinctrl-0 = <&dsi_4lane_pins>;	/* PD0-PD9, function 4, as stock */
+	pinctrl-names = "default";
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	panel@0 {
+		compatible = "dash,s3xy-panel";
+		reg = <0>;
+		power-supply = <&reg_lcd>;
+		/* Panel controller setup (ST7703-family command set), typed from how the stock unit initialises it
+		 * (owner decision 2026-11-13, plan: rule 3 relaxed for the panel). Stock does not pulse PG8. */
+		dash,init = [
+			04 b9 f1 12 87 04 b2 e0 05 78 0b b3 10 10 28 28
+			03 ff 00 00 00 00 02 b4 80 03 b5 0d 0d 03 b6 5d
+			5d 05 b8 27 22 f0 63 1c ba 33 81 05 f9 0e 0e 20
+			00 00 00 00 00 00 00 44 25 00 91 0a 00 00 01 4f
+			01 00 00 37 02 bc 47 06 bf 02 10 00 80 04 0a c0
+			73 73 50 50 00 00 12 73 00 12 c1 24 00 32 32 77
+			e4 77 77 ec ec ff ff 11 11 00 00 32 0d c7 10 00
+			0a 00 00 00 00 00 ed c5 00 a5 05 c8 10 40 1e 03
+			02 cc 0b 23 e0 00 13 19 25 20 29 4b 3d 07 0d 0e
+			12 14 12 14 12 18 00 13 19 25 20 29 4b 3d 07 0d
+			0e 12 14 12 14 12 18 08 e1 11 11 91 00 00 00 00
+			0f e3 07 07 0b 0b 0b 0b 00 00 00 00 ff 84 c0 10
+			40 e9 c8 10 0a 10 0e 80 38 12 31 23 7f 86 80 38
+			47 08 00 00 00 00 00 00 00 40 04 00 00 00 88 88
+			88 88 88 88 88 88 88 88 88 8f 44 56 70 12 38 ba
+			08 88 88 88 00 00 00 01 00 80 38 00 00 00 00 00
+			00 3e ea 96 18 00 00 00 b4 01 0b 00 00 00 00 88
+			88 88 88 88 88 88 88 88 88 88 f8 43 21 07 65 48
+			ba 08 88 88 88 23 00 00 00 b2 00 00 00 00 00 00
+			00 00 00 00 00 07 8b 00 00 40 80 81 40 80 81 00
+			04 ef ff ff 01 02 11 00 ff fa 02 29 00 ff 32
+		];
+		backlight = <&backlight>;
+	};
+};
+
+&pio {
+	/* PD22: brightness input, active low (floating or low = lit). Never a gpio-hog: that broke the pinctrl probe (-22). */
+	pwm7_pd22_pin: pwm7-pd22-pin {
+		pins = "PD22";
+		function = "pwm7";
+	};
+
+	i2c0_pg_pins: i2c0-pg-pins {	/* stock: PG12/PG13 function 3 while the screen is on */
+		pins = "PG12", "PG13";
+		function = "i2c0";
+	};
+};
+
+&i2c0 {
+	pinctrl-0 = <&i2c0_pg_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	touchscreen@14 {		/* stock ctp: gt9xx at 0x14, int PG14, wakeup/reset PG15 */
+		compatible = "goodix,gt911";
+		reg = <0x14>;
+		interrupt-parent = <&pio>;
+		interrupts = <6 14 IRQ_TYPE_EDGE_FALLING>;
+		irq-gpios = <&pio 6 14 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&pio 6 15 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+&usb_otg {				/* stock usbc0: usb_port_type 1 (device) */
+	dr_mode = "peripheral";
+	status = "okay";
+};
+
+&usbphy {
+	status = "okay";
+};
+
+&dcxo {
+	clock-frequency = <24000000>;
+};
+
+&uart4 {
+	status = "okay";
+};
+
+&mmc0 {
+	pinctrl-0 = <&mmc0_pins>;
+	pinctrl-names = "default";
+	vmmc-supply = <&reg_3v3>;
+	broken-cd;		/* card-detect pin not known yet: poll */
+	disable-wp;
+	bus-width = <4>;
+	status = "okay";
+};
+
+&mmc2 {
+	pinctrl-0 = <&mmc2_pins>;
+	pinctrl-names = "default";
+	vmmc-supply = <&reg_3v3>;
+	non-removable;
+	bus-width = <4>;
+	status = "okay";
+};
diff -ruN a/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r2.dts b/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r2.dts
--- a/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r2.dts	1970-01-01 01:00:00
+++ b/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r2.dts	2026-11-13 13:00:43
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+// R2: R1 (display, touch, USB gadget: unchanged, included as is) plus the RTL8733BS radio.
+// WiFi: SDIO on SMHC1 (PG0-PG5), power PG9 (active low). BT: H5 on UART3 (PB6/PB7, no RTS/CTS wired), enable PE13.
+// Pins and polarities from the stock device tree (netRF node) and the stock PIO registers read while stock WiFi ran
+// (PG9 = 0, PE13 = 1). UART5 (PB4/PB5, the other BLE module) is not touched.
+
+#include "sun8i-t113s-dash-r1.dts"
+
+/ {
+	model = "S3XY Dash R2";
+	compatible = "dash,s3xy-dash-r2", "allwinner,sun8i-t113s";
+
+	aliases {
+		mmc2 = &mmc1;		/* SDIO WiFi (mmc0 = microSD, mmc1 = eMMC already) */
+	};
+
+	wifi_pwrseq: wifi-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		/* PG9 = WiFi LDO enable. Tested on the unit 2026-11-13: PG9 HIGH powers the chip (the stock snapshot of PG9 low misled us). */
+		reset-gpios = <&pio 6 9 GPIO_ACTIVE_LOW>;	/* "reset asserted" = PG9 low = off */
+		post-power-on-delay-ms = <1000>;	/* the chip did not answer CMD5 after 100 ms */
+		power-off-delay-us = <200000>;
+	};
+};
+
+&pio {
+	mmc1_pg_pins: mmc1-pg-pins {	/* stock sdc1: PG0-PG5, function 2, 30 mA, pull-up */
+		pins = "PG0", "PG1", "PG2", "PG3", "PG4", "PG5";
+		function = "mmc1";
+		drive-strength = <30>;
+		bias-pull-up;
+	};
+};
+
+&mmc1 {
+	pinctrl-0 = <&mmc1_pg_pins>;
+	pinctrl-names = "default";
+	vmmc-supply = <&reg_3v3>;
+	mmc-pwrseq = <&wifi_pwrseq>;
+	bus-width = <4>;
+	max-frequency = <50000000>;	/* stock: 50 MHz; drop to 25-40 MHz on CRC errors */
+	non-removable;
+	keep-power-in-suspend;
+	cap-sdio-irq;			/* stock sdc1: SDIO only */
+	no-sd;
+	no-mmc;
+	status = "okay";
+};
+
+&uart3 {
+	pinctrl-0 = <&uart3_pb_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	bluetooth {
+		/* RTL8733BS BT half; hci_h5 + btrtl (patch 0004) pick the chip by its HCI ids */
+		compatible = "realtek,rtl8723ds-bt";
+		enable-gpios = <&pio 4 13 GPIO_ACTIVE_HIGH>;	/* stock ldo_bten: PE13, high = on */
+	};
+};
