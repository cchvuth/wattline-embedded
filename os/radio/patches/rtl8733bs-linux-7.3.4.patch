+/* cfg80211 in Linux 7.x: key/station ops take a wireless_dev, cfg80211 hands out ROC/mgmt_tx cookies */
+#define RTW_CFG80211_WDEV_OPS (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0))
+
+/* Linux 7.x dropped strncpy(); keep its exact semantics (copy up to n, zero-pad) for this driver */
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0))
+#include <linux/string.h>
+static inline char *rtw_strncpy(char *dst, const char *src, size_t n)
+{
+	size_t i = 0;
+
+	for (; i < n && src[i]; i++)
+		dst[i] = src[i];
+	for (; i < n; i++)
+		dst[i] = '\0';
+	return dst;
+}
+#undef strncpy
+#define strncpy rtw_strncpy
+#endif
