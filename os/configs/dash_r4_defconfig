# R4 = R3 + the Phase 0 projection spike (hardware tests only, never a product): I2C1/I2C2 enabled for a read-only
# auth-chip scan, the PCF8563 RTC (+ hwclock at boot), the video engine node (cedrus) with a C test decoder and rotate
# estimate, a second WiFi module 8733bs_cc (concurrent mode + MCC, AP) never loaded at boot, hostapd/udhcpd/iperf3 for
# its test access point. Built in /work/out-r4 (br-r4.sh). R3's DT, overlay and module stay as they are.
# Needs /radio and /native as R3 does.
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
# the toolchain and glibc were built on 6.18.8 headers (R0): keep them, the kernel moves to 7.3.4 alone
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="6.18.8"
BR2_GLOBAL_PATCH_DIR="board/mangopi/mq1rdw2/patches $(BR2_EXTERNAL_DASH_PATH)/board/dash/patches $(BR2_EXTERNAL_DASH_PATH)/board/dash/patches-r4"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_TARGET_GENERIC_HOSTNAME="dash"
BR2_TARGET_GENERIC_ISSUE="S3XY Dash R4 spike (eMMC read-only)"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_DASH_PATH)/board/dash/rootfs_overlay $(BR2_EXTERNAL_DASH_PATH)/board/dash/rootfs_overlay_r2 $(BR2_EXTERNAL_DASH_PATH)/board/dash/rootfs_overlay_r3 $(BR2_EXTERNAL_DASH_PATH)/board/dash/rootfs_overlay_r4"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_DASH_PATH)/board/dash/post-build-r3.sh $(BR2_EXTERNAL_DASH_PATH)/board/dash/post-build-r4.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_DASH_PATH)/board/dash/post-image-r4.sh"
BR2_LINUX_KERNEL=y
