#!/bin/sh
# R0 (plan 4.5, 0.2 item 7): every eMMC read-only before anything else runs. Found by type, never by name.
case "$1" in start|"") ;; *) exit 0 ;; esac
i=0; until grep -qx MMC /sys/block/mmcblk[0-9]/device/type 2>/dev/null || [ $i -ge 20 ]; do sleep 1; i=$((i+1)); done      # up to 20 s
for d in /sys/block/mmcblk[0-9]; do [ "$(cat $d/device/type 2>/dev/null)" = MMC ] && blockdev --setro /dev/${d##*/}; done
mount -t debugfs none /sys/kernel/debug 2>/dev/null
for d in /sys/block/mmcblk[0-9]; do echo "${d##*/} $(cat $d/device/type 2>/dev/null) ro=$(blockdev --getro /dev/${d##*/})"; done
