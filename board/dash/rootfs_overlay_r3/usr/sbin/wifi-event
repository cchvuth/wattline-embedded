#!/bin/sh
# wpa_cli's action script (wifi-connect): on every join, a fresh DHCP lease. Without it, udhcpc keeps the last network's
# address after wpa_supplicant moves to another (home WiFi -> the car's), until its lease runs out: no data meanwhile.
# Called as: wifi-event IFACE CONNECTED|DISCONNECTED
[ "$2" = CONNECTED ] || exit 0
# The same network back after a blip keeps its address (no DHCP gap); only a change of network gets a new lease.
[ "$WPA_ID" = "$(cat /run/wifi-id 2>/dev/null)" ] && exit 0
echo "$WPA_ID" > /run/wifi-id
killall -q -USR2 udhcpc   # release the old address
sleep 1                   # the release done before the renew is asked
killall -q -USR1 udhcpc   # and ask the network now joined
exit 0
