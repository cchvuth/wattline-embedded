diff --color -ruN a/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r0.dts b/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r0.dts
--- a/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r0.dts	1970-01-01 01:00:00
+++ b/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r0.dts	2026-11-13 10:33:51
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+// R0: the rescue image's device tree for the S3XY Dash (T113-S4). Console, SD card, eMMC; nothing else.
+// The console UART4 node carries no pinctrl on purpose: the SPL muxes the pins (KCFLAGS -DDASH_U4=n,
+// board/dash/patches/uboot), and U-Boot proper and Linux keep them as set. Typed from the survey, not copied.
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include "sun8i-t113s.dtsi"
+
+/ {
+	model = "S3XY Dash R0";
+	compatible = "dash,s3xy-dash-r0", "allwinner,sun8i-t113s";
+
+	aliases {
+		serial0 = &uart4;
+		mmc0 = &mmc0;	/* microSD (SMHC0, PF0-PF5) */
+		mmc1 = &mmc2;	/* eMMC (SMHC2, PC2-PC7, 4-bit) */
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	reg_3v3: regulator-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+};
+
+&dcxo {
+	clock-frequency = <24000000>;
+};
+
+&uart4 {
+	status = "okay";
+};
+
+&mmc0 {
+	pinctrl-0 = <&mmc0_pins>;
+	pinctrl-names = "default";
+	vmmc-supply = <&reg_3v3>;
+	broken-cd;		/* card-detect pin not known yet: poll */
+	disable-wp;
+	bus-width = <4>;
+	status = "okay";
+};
+
+&mmc2 {
+	pinctrl-0 = <&mmc2_pins>;
+	pinctrl-names = "default";
+	vmmc-supply = <&reg_3v3>;
+	non-removable;
+	bus-width = <4>;
+	status = "okay";
+};
diff --color -ruN a/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r1.dts b/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r1.dts
--- a/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r1.dts	1970-01-01 01:00:00
+++ b/arch/arm/boot/dts/allwinner/sun8i-t113s-dash-r1.dts	2026-11-13 10:33:51
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+// R1: R0 plus the display (MIPI-DSI panel, backlight), touch and the USB gadget, for the S3XY Dash (T113-S4).
+// Display numbers come from the running stock unit (survey display-facts.md); typed by hand. Radios stay off.
+// The console UART4 node carries no pinctrl on purpose: the SPL muxes the pins (KCFLAGS -DDASH_U4=n,
+// board/dash/patches/uboot), and U-Boot proper and Linux keep them as set. Typed from the survey, not copied.
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include "sun8i-t113s.dtsi"
+
+/ {
+	model = "S3XY Dash R1";
+	compatible = "dash,s3xy-dash-r1", "allwinner,sun8i-t113s";
+
+	aliases {
+		serial0 = &uart4;
+		mmc0 = &mmc0;	/* microSD (SMHC0, PF0-PF5) */
+		mmc1 = &mmc2;	/* eMMC (SMHC2, PC2-PC7, 4-bit) */
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	reg_3v3: regulator-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+
+	reg_lcd: regulator-lcd {		/* stock lcd_power_en: PG11, high = on */
+		compatible = "regulator-fixed";
+		regulator-name = "lcd-power";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpio = <&pio 6 11 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <20000>;
+	};
+
+	backlight: backlight {			/* stock lcd_bl_en: PG10. The PWM7 pin (PD22) is left to userspace (gpioset) */
+		compatible = "gpio-backlight";
+		gpios = <&pio 6 10 GPIO_ACTIVE_HIGH>;
+		default-on;
+	};
+};
+
+&de {
+	status = "okay";
+};
+
+&dsi {
+	pinctrl-0 = <&dsi_4lane_pins>;	/* PD0-PD9, function 4, as stock */
+	pinctrl-names = "default";
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+
+	panel@0 {
+		compatible = "dash,s3xy-panel";
+		reg = <0>;
+		power-supply = <&reg_lcd>;
+		reset-gpios = <&pio 6 8 GPIO_ACTIVE_LOW>;	/* stock lcd_gpio_0 (PG8): pulsed low at init, idle high */
+		backlight = <&backlight>;
+	};
+};
+
+&pio {
+	bl-pwm-hog {			/* stock PWM7 pin PD22: brightness input, active low (high = dark). Low = full */
+		gpio-hog;
+		gpios = <3 22 GPIO_ACTIVE_HIGH>;
+		output-low;
+		line-name = "backlight-pwm";
+	};
+
+	i2c0_pg_pins: i2c0-pg-pins {	/* stock: PG12/PG13 function 3 while the screen is on */
+		pins = "PG12", "PG13";
+		function = "i2c0";
+	};
+};
+
+&i2c0 {
+	pinctrl-0 = <&i2c0_pg_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	touchscreen@14 {		/* stock ctp: gt9xx at 0x14, int PG14, wakeup/reset PG15 */
+		compatible = "goodix,gt911";
+		reg = <0x14>;
+		interrupt-parent = <&pio>;
+		interrupts = <6 14 IRQ_TYPE_EDGE_FALLING>;
+		irq-gpios = <&pio 6 14 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&pio 6 15 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+&usb_otg {				/* stock usbc0: usb_port_type 1 (device) */
+	dr_mode = "peripheral";
+	status = "okay";
+};
+
+&usbphy {
+	status = "okay";
+};
+
+&dcxo {
+	clock-frequency = <24000000>;
+};
+
+&uart4 {
+	status = "okay";
+};
+
+&mmc0 {
+	pinctrl-0 = <&mmc0_pins>;
+	pinctrl-names = "default";
+	vmmc-supply = <&reg_3v3>;
+	broken-cd;		/* card-detect pin not known yet: poll */
+	disable-wp;
+	bus-width = <4>;
+	status = "okay";
+};
+
+&mmc2 {
+	pinctrl-0 = <&mmc2_pins>;
+	pinctrl-names = "default";
+	vmmc-supply = <&reg_3v3>;
+	non-removable;
+	bus-width = <4>;
+	status = "okay";
+};
