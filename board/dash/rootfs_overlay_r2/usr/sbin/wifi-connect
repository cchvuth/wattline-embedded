#!/bin/sh
# wifi-connect SSID [PASSPHRASE]: join a network as a station (WPA2/WPA3 personal, or open with no passphrase), then DHCP.
# The config is written to /run (RAM) only; nothing is kept across reboots.
[ -n "$1" ] || { echo "usage: wifi-connect SSID [PASSPHRASE]" >&2; exit 1; }
C=/run/wpa_supplicant.conf
umask 077
{
	echo "ctrl_interface=/run/wpa_supplicant"
	echo "network={"
	echo "	ssid=$(printf %s "$1" | xxd -p | tr -d '\n')"
	if [ -n "$2" ]; then
		echo "	psk=\"$2\""
		echo "	key_mgmt=WPA-PSK WPA-PSK-SHA256 SAE"
		echo "	ieee80211w=1"
	else
		echo "	key_mgmt=NONE"
	fi
	echo "}"
} > $C
killall -q udhcpc wpa_supplicant; sleep 1
ip link set wlan0 up || exit 1
wpa_supplicant -B -i wlan0 -D nl80211 -c $C || exit 1
udhcpc -i wlan0 -b -t 15
